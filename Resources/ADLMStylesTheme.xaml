                     Color="{DynamicResource SignInCol}" />-->

    <SolidColorBrush x:Key="HoverLightBrush"
                     Color="{DynamicResource HoverLightCol}" />
    <SolidColorBrush x:Key="ActiveBgBrush"
                     Color="{DynamicResource ActiveBgCol}" />
    <SolidColorBrush x:Key="PressedBgBrush"
