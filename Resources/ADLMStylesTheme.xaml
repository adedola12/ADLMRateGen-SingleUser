    <Color x:Key="Color.Danger">#FFFF4500</Color>
    <Color x:Key="Color.White">#FFFFFFFF</Color>
    <Color x:Key="Color.Gray">#FFF0F0F0</Color>
    <Color x:Key="Color.RowAlt">#FFF5FAFF</Color>
