    <!-- ─── TEXTBOX STYLES ─── -->
    <Style x:Key="HollowBox"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrushLight}" />
        <Setter Property="BorderThickness"
                Value="1.2" />
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Height"
                Value="46" />
        <Setter Property="Padding"
                Value="14,0" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="12"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OPTextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource HollowBox}">
        <Setter Property="Background"
                Value="{DynamicResource DisabledBgBrush}" />
        <Setter Property="Padding"
                Value="14,0,34,0" />
    </Style>

    <Style x:Key="RoundedTextBox"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="#EDF2F7" />
        <Setter Property="BorderBrush"
                Value="#CBD5E0" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
