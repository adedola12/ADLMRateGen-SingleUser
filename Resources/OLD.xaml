<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ADLMRateGen.Converters"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
                    xmlns:helpers="clr-namespace:ADLMRateGen.Helpers">


    <!-- ─── FONTS ─── -->
    <FontFamily x:Key="Mont">pack://application:,,,/Fonts/#Mont</FontFamily>
    <FontFamily x:Key="PoppinsFont">Poppins</FontFamily>

    <!-- ─── COLOURS & BRUSHES ─── -->
    <Color x:Key="Blue900">#091E39</Color>
    <SolidColorBrush x:Key="MainBg"
                     Color="#FAFDFF" />
    <SolidColorBrush x:Key="Blue900Brush"
                     Color="{DynamicResource Blue900}" />
    <SolidColorBrush x:Key="Grey700"
                     Color="#5F6D7E" />
    <SolidColorBrush x:Key="BgInput"
                     Color="#F2F6FF" />
    <SolidColorBrush x:Key="RowAlt"
                     Color="#F7F9FF" />
    <SolidColorBrush x:Key="ButCol"
                     Color="#1245A8" />
    <SolidColorBrush x:Key="RowHover"
                     Color="#EEF3FF" />
    <SolidColorBrush x:Key="PrimaryBrush2"
                     Color="Black" />
    <SolidColorBrush x:Key="divBrush"
                     Color="#D1D5DB" />
    <SolidColorBrush x:Key="BackgroundBrush"
                     Color="White" />
    <SolidColorBrush x:Key="AltRowBrush"
                     Color="#EDF2F7" />
    <SolidColorBrush x:Key="DataPrimaryBrush"
                     Color="#F7FAFC" />
    <SolidColorBrush x:Key="HeaderBgBrush"
                     Color="#F2F6FF" />
    <SolidColorBrush x:Key="HeaderTextBrush"
                     Color="#2D3748" />
    <SolidColorBrush x:Key="CellTextBrush"
                     Color="#2D3748" />
    <SolidColorBrush x:Key="BorColBrush"
                     Color="#1637FF" />
    <SolidColorBrush x:Key="BorderBrushLight"
                     Color="#CBD5E0" />
    <SolidColorBrush x:Key="LightGrayBrush"
                     Color="#F7FAFC" />
    <SolidColorBrush x:Key="Navy"
                     Color="#091E39" />
    <SolidColorBrush x:Key="HintGrey"
                     Color="#8A94A6" />
    <SolidColorBrush x:Key="VeryLight"
                     Color="#F6F9FF" />
    <Color x:Key="SignInCol">#0055FF</Color>
    <SolidColorBrush x:Key="SignInBrush"
                     Color="{DynamicResource SignInCol}" />



    <!-- ─── CONVERTERS ─── -->
    <conv:PercentConverter x:Key="PercentConverter" />

    <!-- ─── TEXTBOX: HollowBox ─── -->
    <Style x:Key="HollowBox"
           TargetType="TextBox">
        <Setter Property="Height"
                Value="46" />
        <Setter Property="Padding"
                Value="14,0" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrushLight}" />
        <Setter Property="BorderThickness"
                Value="1.2" />
        <Setter Property="Background"
                Value="White" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="12"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ─── RECTANGLE BUTTON (Filter/Sort) ─── -->
    <Style x:Key="RectButton"
           TargetType="Button">
        <Setter Property="Height"
                Value="46" />
        <Setter Property="MinWidth"
                Value="100" />
        <Setter Property="Padding"
                Value="18,0" />
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrushLight}" />
        <Setter Property="BorderThickness"
                Value="1.2" />
        <Setter Property="Background"
                Value="White" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#F5F8FF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ─── PRIMARY BUTTON ─── -->
    <Style x:Key="PrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource RectButton}">
        <Setter Property="Background"
                Value="{DynamicResource ButCol}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ButCol}" />
        <Setter Property="FontSize"
                Value="19" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="MinWidth"
                Value="200" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="brd"
                                    Property="Background"
                                    Value="#07244F" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="brd"
                                    Property="Opacity"
                                    Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── PRIMARY BUTTON OTHRS ─── -->
    <Style x:Key="PrimaryButtonCus"
           TargetType="Button"
           BasedOn="{StaticResource RectButton}">
        <Setter Property="Background"
                Value="{DynamicResource Blue900Brush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Blue900Brush}" />
        <Setter Property="FontSize"
                Value="19" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="MinWidth"
                Value="200" />
        <Setter Property="Height"
                Value="70" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="brd"
                                    Property="Background"
                                    Value="#07244F" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="brd"
                                    Property="Opacity"
                                    Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ─── DATAGRID STYLE ─── -->
    <Style x:Key="DataGridStyle"
           TargetType="DataGrid">
        <Setter Property="Background"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrushLight}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="RowBackground"
                Value="{DynamicResource BackgroundBrush}" />

        <Setter Property="GridLinesVisibility"
                Value="None" />
        <Setter Property="HeadersVisibility"
                Value="Column" />
        <Setter Property="AutoGenerateColumns"
                Value="False" />
        <Setter Property="CanUserAddRows"
                Value="False" />
        <Setter Property="CanUserDeleteRows"
                Value="False" />
        <Setter Property="RowHeaderWidth"
                Value="0" />
        <Setter Property="ColumnHeaderHeight"
                Value="48" />
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontFamily"
                Value="{DynamicResource PoppinsFont}" />
        <Setter Property="Margin"
                Value="10,30" />
        <Setter Property="RowHeight"
                Value="30" />
        <Setter Property="IsReadOnly"
                Value="True" />
        <Setter Property="GridLinesVisibility"
                Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush"
                Value="{DynamicResource BorderBrushLight}" />


        <Setter Property="ScrollViewer.CanContentScroll"
                Value="True" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Auto" />

        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="FontSize"
                            Value="16" />
                    <Setter Property="Padding"
                            Value="10,8" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Center" />
                    <Setter Property="HorizontalContentAlignment"
                            Value="Center" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                    <Setter Property="BorderThickness"
                            Value="0" />

                    <Setter Property="Foreground"
                            Value="{DynamicResource CellTextBrush}" />
                    <Setter Property="FontFamily"
                            Value="{DynamicResource PoppinsFont}" />

                    <Style.Triggers>
                        <!-- when a cell becomes selected… -->
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <!-- …use a very subtle selection color… -->
                            <Setter Property="Background"
                                    Value="{DynamicResource AltRowBrush}" />
                            <!-- …and override the text color if you like -->
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Blue900Brush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontSize"
                            Value="16" />
                    <Setter Property="Background"
                            Value="{DynamicResource HeaderBgBrush}" />

                    <Setter Property="Foreground"
                            Value="{DynamicResource HeaderTextBrush}" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                    <Setter Property="FontFamily"
                            Value="{DynamicResource PoppinsFont}" />
                    <Setter Property="HorizontalContentAlignment"
                            Value="Center" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Center" />
                    <Setter Property="BorderThickness"
                            Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6,6,0,0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderThickness"
                            Value="0" />
                    <Setter Property="Margin"
                            Value="0,2" />
                    <Setter Property="Cursor"
                            Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <Border Background="{TemplateBinding Background}">
                                    <DataGridCellsPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource AltRowBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource DataPrimaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OPText"
           TargetType="TextBlock">
        <!-- fixed percent sign -->
        <Setter Property="Text"
                Value="%" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="#5F6D7E" />
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,12,0" />
    </Style>

    <Style x:Key="OPTextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource HollowBox}">
        <Setter Property="Background"
                Value="#F5F5F5" />
        <Setter Property="Padding"
                Value="14,0,34,0" />
    </Style>

    <!-- Large header for estimates -->
    <Style x:Key="EstHeader"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="52" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
    </Style>

    <!-- Sub-header for estimates -->
    <Style x:Key="EstSubheader"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="Foreground"
                Value="{DynamicResource Grey700}" />
    </Style>

    <!-- button label text -->
    <Style x:Key="BtnText"
           TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="FontSize"
                Value="19" />
        <Setter Property="TextAlignment"
                Value="Center" />
    </Style>


    <!-- ── SIMPLE STYLES & EFFECTS ── -->
    <DropShadowEffect x:Key="SoftShadow"
                      Color="#000000"
                      BlurRadius="10"
                      ShadowDepth="0"
                      Opacity="0.12" />

    <!-- Primary (navy) button used for “Library” -->
    <Style x:Key="NavPrimaryButton"
           TargetType="Button">
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="Background"
                Value="#001E44" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="14,8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Flat nav button (left column) -->
    <Style x:Key="NavFlatButton"
           TargetType="Button">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="#374151" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Padding"
                Value="12,6" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="root"
                                    Property="Background"
                                    Value="#F3F4F6" />
                        </Trigger>
                        <Trigger Property="helpers:ButtonHelper.IsActive"
                                 Value="True">
                            <Setter TargetName="root"
                                    Property="Background"
                                    Value="#E8F0FF" />
                            <Setter Property="Foreground"
                                    Value="#003087" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Simple top-navigation style (blue outline) -->
    <Style x:Key="TopNavButtonStyle"
           TargetType="Button">
        <Setter Property="Margin"
                Value="4" />
        <Setter Property="Padding"
                Value="10,6" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="BorderBrush"
                Value="#0078D4" />
        <Setter Property="BorderThickness"
                Value="1.2" />
        <Setter Property="Background"
                Value="White" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Simple top-navigation style (blue outline) -->
    <Style x:Key="LogBtnStyle"
           TargetType="Button"
           BasedOn="{StaticResource RectButton}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop Color="{DynamicResource SignInCol}"
                                  Offset="0" />
                    <GradientStop Color="{DynamicResource SignInCol}"
                                  Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush"
                Value="{DynamicResource ButCol}" />
        <Setter Property="Margin"
                Value="0,24,0,0" />
        <Setter Property="Height"
                Value="56" />
        <Setter Property="Width"
                Value="520" />
        <Setter Property="FontSize"
                Value="19" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="White" />


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="brd"
                                    Property="Background"
                                    Value="#0055FF" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="brd"
                                    Property="Opacity"
                                    Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── ICON BUTTON (Back arrow) ─── -->
    <Style x:Key="IconButton"
           TargetType="Button">
        <Setter Property="Width"
                Value="34" />
        <Setter Property="Height"
                Value="34" />
        <Setter Property="FontFamily"
                Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="Content"
                Value="" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="Cursor"
                Value="Hand" />
    </Style>

    <!--SIDEBAR BUTTONS-->
    <Style x:Key="SidebarSubButton"
           TargetType="Button">
        <!-- default look -->
        <Setter Property="Background"
                Value="White" />
        <Setter Property="Foreground"
                Value="#091E39" />
        <Setter Property="Padding"
                Value="20,12" />
        <Setter Property="MinHeight"
                Value="48" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Cursor"
                Value="Hand" />

        <!-- GIVE IT A MAX WIDTH—when the text exceeds this width it will wrap -->
        <Setter Property="MaxWidth"
                Value="180" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <!-- center the content -->
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!-- hover -->
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#F3F4F6" />
            </Trigger>
            <!-- active/current -->
            <Trigger Property="helpers:ButtonHelper.IsActive"
                     Value="True">
                <Setter Property="Background"
                        Value="#E8F0FF" />
                <Setter Property="Foreground"
                        Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- sidebar button text + icon pairing is always the same -->
    <Style x:Key="BtnSidebarText"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="Poppins" />
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="MaxWidth"
                Value="120" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
    </Style>


    <!-- ─── HEADLINE & BODY TEXTBLOCKS ─── -->
    <Style x:Key="Headline"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="36" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource HintGrey}" />
    </Style>

    <Style x:Key="Body"
           TargetType="TextBlock"
           BasedOn="{StaticResource Headline}">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
    </Style>

    <!-- Main heading text -->
    <Style x:Key="MainHeadingText"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="52" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
    </Style>

    <!-- Sub-heading text -->
    <Style x:Key="SubheadingText"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource Mont}" />
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="Foreground"
                Value="{DynamicResource Grey700}" />
    </Style>

    <!-- ─── DETAIL GRID STYLE (lighter) ─── -->
    <Style x:Key="DetailGrid"
           TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns"
                Value="False" />
        <Setter Property="HeadersVisibility"
                Value="Column" />
        <Setter Property="RowBackground"
                Value="White" />
        <Setter Property="GridLinesVisibility"
                Value="None" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="FontFamily"
                Value="{DynamicResource PoppinsFont}" />
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="DemiBold" />
        <Setter Property="IsReadOnly"
                Value="True" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />

        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <!-- padding inside each cell -->
                    <Setter Property="Padding"
                            Value="8,8" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Center" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource CellTextBrush}" />
                    <!-- bottom border to separate rows -->
                    <Setter Property="BorderThickness"
                            Value="0,0,0,1" />
                    <Setter Property="Margin"
                            Value="5,10" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BorderBrushLight}" />

                    <Style.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="#10003050" />
                        </Trigger>
                        <!-- when a cell becomes selected… -->
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <!-- …use a very subtle selection color… -->
                            <Setter Property="Background"
                                    Value="#20003050" />
                            <!-- …and override the text color if you like -->
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Blue900Brush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>



        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"
                            Value="{DynamicResource HeaderBgBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource HeaderTextBrush}" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                    <Setter Property="HorizontalContentAlignment"
                            Value="Left" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Center" />
                    <Setter Property="Padding"
                            Value="12,8" />
                    <Setter Property="FontSize"
                            Value="20" />
                    <!-- bottom border under headers -->
                    <Setter Property="BorderThickness"
                            Value="0,0,0,1" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BorderBrushLight}" />
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">

                    <Setter Property="BorderThickness"
                            Value="0" />
                    <Setter Property="Margin"
                            Value="0" />
                </Style>
            </Setter.Value>


        </Setter>

    </Style>

    <!-- ─── WRAP CELL TEXT ─── -->
    <Style x:Key="WrapCellText"
           TargetType="TextBlock">
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0" />
    </Style>

    <Style x:Key="CenterCellText"
           TargetType="TextBlock">
        <!-- this will make your Quantity/Unit/Price columns centered -->
        <Setter Property="FontFamily"
                Value="{DynamicResource PoppinsFont}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="{DynamicResource CellTextBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />

        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CenterCellNr"
           TargetType="TextBlock">
        <!-- this will make your Quantity/Unit/Price columns centered -->
        <Setter Property="FontFamily"
                Value="{DynamicResource PoppinsFont}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="{DynamicResource CellTextBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>


    <!-- ─── FLAT TAB BUTTON ─── -->
    <Style x:Key="FlatTabButton"
           TargetType="ToggleButton">
        <Setter Property="FontFamily"
                Value="{DynamicResource PoppinsFont}" />
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource Blue900Brush}" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="root"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="root"
                                    Property="Background"
                                    Value="White" />
                            <Setter Property="Foreground"
                                    Value="#003087" />
                            <Setter TargetName="root"
                                    Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="5"
                                                      ShadowDepth="0"
                                                      Color="#00000026" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── PRIMARY ACCENT BUTTON ─── -->
    <Style x:Key="PrimaryAccentButton"
           TargetType="Button"
           BasedOn="{StaticResource RectButton}">
        <Setter Property="Width"
                Value="200" />
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="Background"
                Value="{DynamicResource Blue900Brush}" />
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Blue900Brush}" />
    </Style>

    <!-- ───── Toolbar ComboBox ───── -->
    <Style x:Key="TopNavComboBoxStyle"
           TargetType="ComboBox">
        <Setter Property="Background"
                Value="White" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrushLight}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="12,4" />
        <Setter Property="FontFamily"
                Value="{DynamicResource PoppinsFont}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- the closed‐state border + selected‐item -->
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <!-- content -->
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="8,0,28,0"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                                <!-- down arrow -->
                                <TextBlock Text="⌄"
                                           FontFamily="Segoe MDL2 Assets"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,12,0"
                                           Foreground="{TemplateBinding Foreground}" />

                                <!-- toggle button to open/close -->
                                <ToggleButton x:Name="DropDownToggle"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              HorizontalAlignment="Right"
                                              Width="28"
                                              Background="Transparent"
                                              BorderBrush="Transparent" />
                            </Grid>
                        </Border>

                        <!-- the drop-down list -->
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border x:Name="PopupBorder"
                                    Background="White"
                                    BorderBrush="{DynamicResource BorderBrushLight}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,4,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{DynamicResource LightGrayBrush}" />
                        </Trigger>
                        <Trigger Property="HasItems"
                                 Value="False">
                            <Setter TargetName="PopupBorder"
                                    Property="MinHeight"
                                    Value="95" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Foreground"
                                    Value="#888" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary CTA Button -->
    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button">
        <!-- Visual defaults -->
        <Setter Property="Background"
                Value="White" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrushLight}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Foreground"
                Value="{DynamicResource HeaderTextBrush}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Padding"
                Value="12,6" />
        <Setter Property="Cursor"
                Value="Hand" />

        <!-- Template with corner radius -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- Hover state -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#F3F4F6" />
            </Trigger>
            <Trigger Property="IsPressed"
                     Value="True">
                <Setter Property="Background"
                        Value="#E5E9ED" />
            </Trigger>
        </Style.Triggers>
    </Style>



    <!-- Rounded TextBox -->
    <Style x:Key="RoundedTextBox"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="#EDF2F7" />
        <Setter Property="BorderBrush"
                Value="#CBD5E0" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded Button -->
    <Style x:Key="RoundedButton"
           TargetType="Button">
        <Setter Property="Background"
                Value="#1A202C" />
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Height"
                Value="48" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#111A2B" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="TBInput"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBox}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEditing}"
                         Value="True">
                <!-- when editing is on, make it read-only and “disabled” looking -->
                <Setter Property="IsReadOnly"
                        Value="True" />
                <Setter Property="Foreground"
                        Value="#888" />
                <Setter Property="Background"
                        Value="#F4F4F4" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!-- 1) A Style for a “SearchBox” that builds on your HollowBox -->
    <Style x:Key="SearchBoxWithIcon"
           TargetType="TextBox"
           BasedOn="{StaticResource HollowBox}">

        <!-- we don’t need the Padding setter here because PART_ContentHost margin will handle it -->
        <Setter Property="Padding"
                Value="44,0,12,0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- the HollowBox border, via TemplateBinding -->
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <!-- where the text actually goes -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <!-- the search icon, overlaid on the left -->
                        <fa:IconBlock Icon="Search"
                                      Width="24"
                                      Height="24"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="16,0,0,0"
                                      Foreground="{DynamicResource BorderBrushLight}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- … inside your ResourceDictionary … -->
    <Style x:Key="WatermarkedTextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource TBInput}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- real text host -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />

                        <!-- watermark -->
                        <TextBlock x:Name="Watermark"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="#888"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- when Text is empty or null, show Watermark -->
                        <Trigger Property="Text"
                                 Value="">
                            <Setter TargetName="Watermark"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>

                        <Trigger Property="Text"
                                 Value="{x:Null}">
                            <Setter TargetName="Watermark"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
 

</ResourceDictionary>
