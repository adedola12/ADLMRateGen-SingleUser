<UserControl x:Class="ADLMCivilPlugin.Controls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ADLMCivilPlugin.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource PrimaryColor}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image Source="/Images/logoWhite.png" Width="100" Margin="5"/>
            <TextBlock Text="ADLM Rate Gen" FontSize="30"
         Foreground="White" VerticalAlignment="Center" FontWeight="ExtraBold"/>
            <TextBlock Text="Version 1.0" FontSize="16" FontWeight="Bold"
         Foreground="#F46A27" VerticalAlignment="Bottom"  Margin="5 0"/>
        </StackPanel>
    </Grid>
</UserControl>
