<UserControl x:Class="ADLMCivilPlugin.Controls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:ADLMRateGen.Services"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             Height="64">

    <!-- ───────── RESOURCES ───────── -->
    <UserControl.Resources>
        <conv:CountToBoolConverter x:Key="CountToBool" />
        <conv:BoolToVis              x:Key="BoolToVisibility" />
        <conv:EmptyCollectionToVisibility x:Key="EmptyCollectionToVisibility" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <Binding Path="DataContext"
                 RelativeSource="{RelativeSource AncestorType=Window}" />
    </UserControl.DataContext>

    <!-- ───────── LAYOUT ───────── -->
    <Grid>

        <!-- columns   0 search | 1 spacer | 2 right-area -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ═══ SEARCH ═══ -->
        <Border Background="{DynamicResource BorderBrushLight}"
                CornerRadius="10"
                VerticalAlignment="Center"
                Margin="24,0">


            <Grid DataContext="{Binding GlobalSearch}">

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                             Style="{DynamicResource HollowBox}"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             Padding="32,0,48,0"
                             VerticalContentAlignment="Center" />
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource BorderBrushLight}" />
                    <TextBlock Text="⌘F"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Tag="Search everywhere…"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource BorderBrushLight}" />
                </Grid>

                <!-- suggestions -->
                <Popup IsOpen="{Binding Suggestions.Count,
                        Converter={StaticResource CountToBool},
                        Mode=OneWay}"
                       PlacementTarget="{Binding ElementName=SearchBox}"
                       StaysOpen="False">
                    <Border Background="{DynamicResource BorderBrushLight}"
                            BorderBrush="#C7CED9"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinWidth="{Binding ElementName=SearchBox, Path=ActualWidth}">
                        <ListBox x:Name="SuggestionList"
                                 ItemsSource="{Binding Suggestions}"
                                 MouseLeftButtonUp="SuggestionList_Click">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="6,2">
                                        <TextBlock Text="{Binding Display}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="  –  "
                                                   Foreground="#808080" />
                                        <TextBlock Text="{Binding Category}"
                                                   Foreground="#606060" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

            </Grid>
        </Border>



        <!-- ═══ RIGHT GROUP ═══ -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0,0,10,0"
                    x:Name="RightGroupPanel">

            <!-- currency -->
            <Border Style="{StaticResource RightGroupItemMargin}"
                    Background="{DynamicResource BorderBrushLight}"
                    BorderBrush="{DynamicResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4"
                    VerticalAlignment="Center">
                <ComboBox Width="80"
                          ItemsSource="{Binding Source={x:Static services:CurrencyService.Instance}, Path=Supported}"
                          SelectedItem="{Binding Source={x:Static services:CurrencyService.Instance}, Path=Selected}"
                          BorderThickness="0"
                          Background="{DynamicResource BorderBrushLight}"
                          FontFamily="Poppins"
                          FontSize="12"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Image Width="16"
                                       Height="11"
                                       Source="{Binding Converter={StaticResource CurrencyToFlagConverter}}"
                                       Margin="0,0,4,0" />
                                <TextBlock Text="{Binding}"
                                           FontFamily="Poppins"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>

            <!-- color mode icon -->
            <!--<Button Style="{DynamicResource IconButton}"
                    Click="ColorModeButton_Click"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0">
                <fa:IconBlock x:Name="ColorModeIcon"
                              Icon="Moon"
                              Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            </Button>-->

            <!-- bell icon -->
            <Button x:Name="BellButton"
                    Style="{DynamicResource IconButton}"
                    Command="{Binding ToggleNotificationsCommand}"
                    ToolTip="How price updates"
                    Margin="0,0,16,0">
                <Grid>
                    <fa:IconBlock Icon="Bell"
                                  Width="24"
                                  Height="24"
                                  Foreground="{DynamicResource Blue900Brush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    <Ellipse Width="8"
                             Height="8"
                             Fill="Tomato"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="1"
                             Visibility="{Binding HasPriceNotifications,
                      Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>

            <!-- user info -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUser.Username}"
                               FontFamily="Poppins"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource Navy}" />
                    <TextBlock Text="{Binding CurrentUser.Email}"
                               FontFamily="Poppins"
                               FontSize="11"
                               Foreground="#5A6273" />
                </StackPanel>
            </StackPanel>
        </StackPanel>


    </Grid>
</UserControl>
