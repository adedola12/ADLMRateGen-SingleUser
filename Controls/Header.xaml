<UserControl x:Class="ADLMCivilPlugin.Controls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:ADLMRateGen.Services"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             Height="96"
             Loaded="Header_Loaded">

    <UserControl.Resources>
        <conv:CountToBoolConverter x:Key="CountToBool" />
        <conv:BoolToVis x:Key="BoolToVisibility" />
        <conv:EmptyCollectionToVisibility x:Key="EmptyCollectionToVisibility" />

        <Style x:Key="HeaderSurfaceBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource MainBg}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="18" />
        </Style>

        <Style x:Key="HeaderActionButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="36" />
            <Setter Property="Height"
                    Value="36" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource HoverLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource PressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.DataContext>
        <Binding Path="DataContext"
                 RelativeSource="{RelativeSource AncestorType=Window}" />
    </UserControl.DataContext>

    <Border Margin="24,12,24,6"
            Padding="14"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="26"
            Effect="{DynamicResource SoftShadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SearchSurface"
                    Grid.Column="0"
                    Height="48"
                    Padding="16,0"
                    Style="{StaticResource HeaderSurfaceBorderStyle}">
                <Grid DataContext="{Binding GlobalSearch}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fa:IconBlock Grid.Column="0"
                                  Icon="Search"
                                  Width="16"
                                  Height="16"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource HintGrey}" />

                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource PoppinsFont}"
                                 FontSize="14"
                                 Foreground="{DynamicResource CellTextBrush}"
                                 CaretBrush="{DynamicResource Blue900Brush}"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,1,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="Search here..."
                                   FontFamily="{DynamicResource PoppinsFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource HintGrey}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}"
                                                     Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Column="2"
                            Margin="12,0,0,0"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrushLight}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock Text="Ctrl + F"
                                   FontFamily="{DynamicResource PoppinsFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Grey700}" />
                    </Border>

                    <Popup IsOpen="{Binding Suggestions.Count, Converter={StaticResource CountToBool}, Mode=OneWay}"
                           PlacementTarget="{Binding ElementName=SearchSurface}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushLight}"
                                BorderThickness="1"
                                CornerRadius="14"
                                MinWidth="{Binding ElementName=SearchSurface, Path=ActualWidth}"
                                Padding="6"
                                Effect="{DynamicResource SoftShadow}">
                            <ListBox x:Name="SuggestionList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding Suggestions}"
                                     MouseLeftButtonUp="SuggestionList_Click">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Display}"
                                                       FontFamily="{DynamicResource PoppinsFont}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Blue900Brush}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="18,0,0,0"
                                                       Text="{Binding Category}"
                                                       FontFamily="{DynamicResource PoppinsFont}"
                                                       Foreground="{DynamicResource Grey700}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Height="40"
                        Margin="0,0,10,0"
                        Padding="10,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource HeaderSurfaceBorderStyle}">
                    <ComboBox Width="86"
                              ItemsSource="{Binding Source={x:Static services:CurrencyService.Instance}, Path=Supported}"
                              SelectedItem="{Binding Source={x:Static services:CurrencyService.Instance}, Path=Selected}"
                              BorderThickness="0"
                              Background="Transparent"
                              Foreground="{DynamicResource CellTextBrush}"
                              FontFamily="{DynamicResource PoppinsFont}"
                              FontSize="11"
                              VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Image Width="16"
                                           Height="11"
                                           Source="{Binding Converter={StaticResource CurrencyToFlagConverter}}"
                                           Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{DynamicResource PoppinsFont}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                    <Button x:Name="ColorModeButton"
                            Margin="0,0,4,0"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Click="ColorModeButton_Click">
                        <fa:IconBlock x:Name="ColorModeIcon"
                                      Width="16"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource Blue900Brush}" />
                    </Button>

                    <Button x:Name="BellButton"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Command="{Binding ToggleNotificationsCommand}"
                            ToolTip="Price update notifications">
                        <Grid>
                            <fa:IconBlock Icon="Bell"
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource Blue900Brush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#FF6B57"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,6,6,0"
                                     Visibility="{Binding HasPriceNotifications, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Button Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="0"
                        Click="ProfileButton_Click"
                        ToolTip="Open your ADLM profile">
                    <Border Padding="6,6,10,6"
                            Style="{StaticResource HeaderSurfaceBorderStyle}"
                            CornerRadius="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="38"
                                  Height="38">
                                <Ellipse Fill="{DynamicResource BgInput}" />
                                <Ellipse Margin="1.5">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding CurrentUser.AvatarSource, Mode=OneWay}"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{DynamicResource SignInBrush}"
                                         Stroke="{DynamicResource BackgroundBrush}"
                                         StrokeThickness="2"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom" />
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,8,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.DisplayName, Mode=OneWay}"
                                           MaxWidth="170"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource PoppinsFont}"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource Blue900Brush}" />
                                <TextBlock Text="{Binding CurrentUser.Email, Mode=OneWay}"
                                           MaxWidth="170"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource PoppinsFont}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource Grey700}" />
                            </StackPanel>

                            <fa:IconBlock Grid.Column="2"
                                          Icon="ChevronDown"
                                          Width="11"
                                          Height="11"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource Grey700}" />
                        </Grid>
                    </Border>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
