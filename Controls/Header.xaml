<UserControl x:Class="ADLMCivilPlugin.Controls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="64">

    <!-- ───────── RESOURCES ───────── -->
    <UserControl.Resources>

        <!-- basic colours -->
        <SolidColorBrush x:Key="Navy"
                         Color="#091E39" />
        <SolidColorBrush x:Key="HintGrey"
                         Color="#8A94A6" />
        <SolidColorBrush x:Key="VeryLight"
                         Color="#F6F9FF" />

        <!-- simple watermark style -->
        <Style x:Key="WatermarkTextBox"
               TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" />
                            <TextBlock x:Name="water"
                                       Margin="2,0,0,0"
                                       Foreground="{StaticResource HintGrey}"
                                       Text="{TemplateBinding Tag}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text"
                                     Value="">
                                <Setter TargetName="water"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="Text"
                                     Value="{x:Null}">
                                <Setter TargetName="water"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="water"
                                        Property="Visibility"
                                        Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- icon-only button -->
        <Style x:Key="IconButton"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="#5A6273" />
            <Setter Property="FontFamily"
                    Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="Padding"
                    Value="6" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <conv:CountToBoolConverter x:Key="CountToBool" />

    </UserControl.Resources>

    <UserControl.DataContext>
        <Binding Path="DataContext"
                 RelativeSource="{RelativeSource AncestorType=Window}" />
    </UserControl.DataContext>

    <!-- ───────── LAYOUT ───────── -->
    <Grid Background="White">

        <!-- columns   0 search | 1 spacer | 2 right-area -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ═══ SEARCH ═══ -->
        <Border Background="{StaticResource VeryLight}"
                CornerRadius="10"
                Height="36"
                VerticalAlignment="Center"
                Margin="24,0">
            
            
            <Grid DataContext="{Binding GlobalSearch}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <!-- magnifier -->
                <TextBlock Grid.Column="0"
                           Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           Foreground="{StaticResource HintGrey}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <!-- editable search box -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Poppins"
                         FontSize="13"
                         Foreground="{StaticResource Navy}"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource WatermarkTextBox}"
                         Tag="Search everywhere…"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

                <!-- suggestions -->
                <Popup IsOpen="{Binding Suggestions.Count,
                        Converter={StaticResource CountToBool},
                        Mode=OneWay}"          
                    PlacementTarget="{Binding ElementName=SearchBox}"
       StaysOpen="False">
                    <Border Background="White"
                            BorderBrush="#C7CED9"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinWidth="{Binding ElementName=SearchBox, Path=ActualWidth}">
                        <ListBox x:Name="SuggestionList"
                                 ItemsSource="{Binding Suggestions}"
                                 MouseLeftButtonUp="SuggestionList_Click">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="6,2">
                                        <TextBlock Text="{Binding Display}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="  –  "
                                                   Foreground="#808080" />
                                        <TextBlock Text="{Binding Category}"
                                                   Foreground="#606060" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
 
            </Grid>
        </Border>

        <!-- ═══ RIGHT GROUP ═══ -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,24,0">

            <!-- currency -->
            <Border Background="#F8FAFF"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4"
                    Margin="0,0,16,0">
                <ComboBox Width="80"
                          SelectedIndex="0"
                          BorderThickness="0"
                          Background="Transparent"
                          FontFamily="Poppins"
                          FontSize="12"
                          Foreground="{StaticResource Navy}">
                    <ComboBoxItem Content="🇳🇬 NGN" />
                    <ComboBoxItem Content="🇺🇸 USD" />
                    <ComboBoxItem Content="€ EUR" />
                </ComboBox>
            </Border>

            <!-- icons -->
            <Button Style="{StaticResource IconButton}"
                    Content="&#xE706;"
                    Margin="0,0,16,0" />
            <DatePicker SelectedDate="{x:Static sys:DateTime.Now}"
                        DisplayDateStart="2024-01-01"
                        DisplayDateEnd="2050-12-31"
                        FontFamily="Poppins"
                        FontSize="12"
                        BorderThickness="0"
                        Background="Transparent"
                        Margin="0,0,16,0" />
            <Button Style="{StaticResource IconButton}"
                    Content="&#xE814;"
                    Margin="0,0,24,0" />

            <!-- user -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,8,0">

                <StackPanel>
                    <TextBlock Text="{Binding CurrentUser.Username}"
                               FontFamily="Poppins"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource Navy}" />

                    <TextBlock Text="{Binding CurrentUser.Email}"
                               FontFamily="Poppins"
                               FontSize="11"
                               Foreground="#5A6273" />
                </StackPanel>

                <Button Style="{StaticResource IconButton}"
                        Content="&#xE8BB;"
                        Command="{Binding LogoutCommand}"
                        Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
