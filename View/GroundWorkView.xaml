<UserControl x:Class="ADLMRateGen.View.GroundWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Input Form -->
            <RowDefinition Height="Auto"/>
            <!-- Rate Section -->
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Groundworks Computation" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Using Material and Labour Prices from the Library" FontSize="15"/>
        </StackPanel>

        <!-- 2. Input Form -->
        <Grid Grid.Row="1" Margin="0,10,0,10">

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Overhead -->
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Overhead (%)" FontSize="15" FontWeight="DemiBold"/>
                    <TextBox Text="{Binding OverheadPercent, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                </StackPanel>

                <!-- Profit -->
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Profit (%) " FontSize="15" FontWeight="DemiBold"/>
                    <TextBox Text="{Binding ProfitPercent, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Update"  Height="40" FontSize="15" FontWeight="DemiBold" 
                VerticalAlignment="Center" Margin="5" Command="{Binding RecomputeCommand}"/>

            </Grid>
        </Grid>

        <!-- 3. Rate Data -->
        <Grid Grid.Row="2" Margin="0,10,0,10">
            <DataGrid ItemsSource="{Binding GroundworkItems}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item No." Binding="{Binding ItemNo}" Width="Auto"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Padding" Value="5,2,5,2"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="Auto"/>
                    <DataGridTextColumn Header="Net Cost" Binding="{Binding NetCost, StringFormat={}{0:N2}}" Width="Auto"/>
                    <DataGridTextColumn Header="Overhead" Binding="{Binding OverheadValue, StringFormat={}{0:N2}}" Width="Auto"/>
                    <DataGridTextColumn Header="Profit" Binding="{Binding ProfitValue, StringFormat={}{0:N2}}" Width="Auto"/>
                    <DataGridTextColumn Header="Total Cost" Binding="{Binding TotalCost, StringFormat={}{0:N2}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>


    </Grid>
</UserControl>
