<UserControl x:Class="ADLMRateGen.View.CarbonOthersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="720">
    <!-- ───────── LAYOUT ───────── -->
    <Border BorderBrush="{DynamicResource LightGrayBrush}"
            BorderThickness="2"
            Effect="{StaticResource SoftShadow}"
            CornerRadius="6"
            Padding="20,0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- ① Header -->
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Carbon &amp; Others Computation"
                               Style="{StaticResource EstHeader}" />
                    <TextBlock Text="Using material and labor prices from the library."
                               Style="{StaticResource EstSubheader}" />
                </StackPanel>
                <!-- Add-custom-rate button (same as Groundwork) -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonCus}"
                        Command="{Binding AddCustomRateCommand}"
                        Width="276"
                        Margin="480,0,0,0">
                    <TextBlock Text="Add Custom Rate  ＋"
                               Style="{StaticResource BtnText}" />
                </Button>
            </DockPanel>
            <Border Background="{DynamicResource MainBg}"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource LightGrayBrush}"
                    Padding="24"
                    SnapsToDevicePixels="True"
                    Grid.Row="1"
                    Margin="0,22,0,-22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- ② Toolbar -->
                    <Grid Grid.Row="0"
                          Margin="0,10,0,10">
                        <!--  ▸ columns: 160 | 16 | 160 | 16 | * | 16 | 110 | 16 | 110  -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <!-- ────── Overhead ────── -->
                        <Border Background="{DynamicResource DisabledBgBrush}"
                                BorderBrush="{DynamicResource BorderBrushLight}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,0"
                                Height="46">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource OOText}"
                                           Text="Overhead" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource OPTextBox}"
                                         Text="{Binding OverheadPercent, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="0"
                                         FontWeight="SemiBold"
                                         FontFamily="{DynamicResource Mont}"
                                         Foreground="{DynamicResource Grey700}" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource OPText}"
                                           Text="%" />
                            </Grid>
                        </Border>
                        <!-- ────── Profit ────── -->
                        <Border Background="{DynamicResource DisabledBgBrush}"
                                BorderBrush="{DynamicResource BorderBrushLight}"
                                BorderThickness="1"
                                Grid.Column="2"
                                CornerRadius="8"
                                Padding="14,0"
                                Height="46">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource OSPText}"
                                           Text="Profit" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource OPTextBox}"
                                         Text="{Binding ProfitPercent, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="0"
                                         FontWeight="SemiBold"
                                         FontFamily="{DynamicResource Mont}"
                                         Foreground="{DynamicResource Grey700}" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource OPText}"
                                           Text="%" />
                            </Grid>
                        </Border>
                        <!-- ────── Search ────── -->
                        <Grid Grid.Column="4"
                              Height="46">
                            <TextBox Style="{StaticResource SearchBoxWithIcon}"
                                     Tag="Search description…"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </Grid>
                        <!-- ────── Buttons ────── -->
                        <Button Grid.Column="6"
                                Content="Filter ⌄"
                                Command="{Binding FilterCommand}"
                                Style="{StaticResource RectButton}" />
                        <Button Grid.Column="8"
                                Content="Sort by ⌄"
                                Command="{Binding SortCommand}"
                                Style="{StaticResource RectButton}" />
                    </Grid>
                    <!-- ③ Table -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ItemsView}"
                              Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="S/N"
                                                Binding="{Binding ItemNo}"
                                                Width="60"
                                                ElementStyle="{StaticResource CenterCellNr}" />
                            <DataGridTemplateColumn Header="Description"
                                                    Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Blue900Brush}"
                                                   Style="{StaticResource CenterCellText}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ShowDetailsCommand,
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings></TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Unit"
                                                Binding="{Binding Unit}"
                                                Width="90"
                                                ElementStyle="{StaticResource CenterCellNr}" />
                            <DataGridTextColumn Header="Net Cost"
                                                Binding="{Binding NetCost, Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                Width="110"
                                                ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="Profit"
                                                Binding="{Binding ProfitValue, Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                Width="110"
                                                ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="Overhead"
                                                Binding="{Binding OverheadValue, Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                Width="110"
                                                ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="Total Cost"
                                                Binding="{Binding TotalCost, Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                Width="120"
                                                ElementStyle="{StaticResource CenterCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
