<UserControl x:Class="ADLMRateGen.View.SteelWorkDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="760">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 2️⃣  HEADER  (row 0) -->
        <DockPanel Margin="0 0 0 18"
                   Grid.Row="0">
            <!-- ✨ add Grid.Row -->
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource IconButton}"
                    Click="BackButton_Click" />
            <StackPanel>
                <TextBlock Text="Rate Composition"
                           Style="{StaticResource Headline}" />
                <TextBlock Text="{Binding Description}"
                           Style="{StaticResource Body}"
                           Width="660"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- DataGrid: Display breakdown lines -->
        <Border Grid.Row="1"
                BorderThickness="0">
            <Grid>
                <!-- dotted outline -->
                <Rectangle Stroke="{StaticResource Blue900Brush}"
                           StrokeThickness="1"
                           StrokeDashArray="2 2" />

                <!-- table -->
                <DataGrid ItemsSource="{Binding SteelWorkBreakdownLines}"
                          Margin="1"
                          RowHeight="{x:Static sys:Double.NaN}"
                          Style="{StaticResource DetailGrid}">

                    <!-- bold total lines -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="FontWeight"
                                    Value="Normal" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTotalLine}"
                                             Value="True">
                                    <Setter Property="FontWeight"
                                            Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Component"
                                            Binding="{Binding ComponentName}"
                                            Width="*"
                                            ElementStyle="{StaticResource WrapCellText}" />

                        <DataGridTextColumn Header="Quantity"
                                            Binding="{Binding Quantity}"
                                            Width="110" />

                        <DataGridTextColumn Header="Unit"
                                            Binding="{Binding Unit}"
                                            Width="100" />

                        <DataGridTextColumn Header="Unit Price"
                                            Binding="{Binding UnitPrice, Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                            Width="120" />

                        <DataGridTextColumn Header="Total Cost"
                                            Binding="{Binding TotalPrice,  Converter={StaticResource MoneyConv},StringFormat=N2}"
                                            Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        
     
    </Grid>
</UserControl>
