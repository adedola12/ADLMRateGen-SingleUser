<UserControl x:Class="ADLMRateGen.View.CustomRateListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <!-- ───────── LAYOUT ───────── -->
    <Border BorderThickness="2"
            BorderBrush="Transparent"
            CornerRadius="6"
            Padding="20,0"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Saved Custom Rates"
                               Style="{StaticResource EstHeader}" />
                    
                    
                    <TextBlock Text="View, search or delete your custom rates."
                               Style="{StaticResource EstSubheader}" />
                </StackPanel>

                <!-- Add‑custom‑rate button -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonCus}"
                        Command="{Binding DeleteRateCommand}"
                        Width="276"
                        Margin="680,0,0,0"
                        >

                    <TextBlock Text="Delete Selected  Rate "
                               Style="{StaticResource BtnText}" />
                </Button>
            </DockPanel>

            <Border Background="{DynamicResource MainBg}"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource LightGrayBrush}"
                    Padding="24"
                    SnapsToDevicePixels="True"
                    Grid.Row="1"
                    Margin="0,22,0,-22">
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,10,0,10">

                        <!--  ▸ columns: 160 | 16 | 160 | 16 | * | 16 | 110 | 16 | 110  -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>

                        <!-- ────── Search ────── -->
                        <Grid Grid.Column="4"
                              Height="46">
                            <TextBox Style="{StaticResource SearchBoxWithIcon}"
                                     Tag="Search description…"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />

                            
                                    
                        </Grid>




                        <!-- ────── Buttons ────── -->
                        <Button Grid.Column="6"
                                Content="Filter ⌄"
                                Command="{Binding FilterCommand}"
                                Style="{StaticResource RectButton}" />

                        <Button Grid.Column="8"
                                Content="Sort by ⌄"
                                Style="{StaticResource RectButton}"
                                Command="{Binding SortCommand}" />

                    </Grid>

                    <!-- 3. DataGrid of Rates -->

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RatesView}"
                              SelectedItem="{Binding SelectedRate}"
                              Style="{StaticResource DataGridStyle}">


                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title"
                                                Binding="{Binding Title}"
                                                Width="*"
                                                ElementStyle="{StaticResource CenterCellNr}" />
                            <DataGridTemplateColumn Header="Description"
                                                    Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Blue900Brush}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ViewRateCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>



                            <DataGridTextColumn Header="Overhead (%)"
                                                Binding="{Binding OverheadPercent}"
                                                Width="90"
                                                ElementStyle="{StaticResource CenterCellNr}" />
                            <DataGridTextColumn Header="Profit (%)"
                                                Binding="{Binding ProfitPercent}"
                                                Width="110"
                                                ElementStyle="{StaticResource CenterCellNr}" />
                            <DataGridTextColumn Header="Grand Total"
                                                Width="140"
                                                Binding="{Binding GrandTotal,
                                      Converter={StaticResource MoneyConv}}"
                                                ElementStyle="{StaticResource CenterCellText}" />

                            <DataGridTextColumn Header="Created Date"
                                                Binding="{Binding CreatedDate}"
                                                Width="150"
                                                ElementStyle="{StaticResource CenterCellText}" />

                        </DataGrid.Columns>
                    </DataGrid>


                </Grid>

            </Border>

        </Grid>
    </Border>
</UserControl>
