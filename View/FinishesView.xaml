<UserControl x:Class="ADLMRateGen.View.FinishesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <!-- ───────── LAYOUT ───────── -->
    <Border BorderThickness="2"
            BorderBrush="Transparent"
            CornerRadius="6"
            Padding="20,0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Finishes Computation"
                               FontFamily="{StaticResource Mont}"
                               FontSize="52"
                               FontWeight="Bold"
                               Foreground="{StaticResource Blue900Brush}" />
                    <TextBlock Text="Using Material and Labour Prices from the Library"
                               FontFamily="{StaticResource Mont}"
                               FontSize="18"
                               Foreground="{StaticResource Grey700}" />
                </StackPanel>

                <!-- Add‑custom‑rate button -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCustomRateCommand}"
                        Width="276"
                        Margin="680,0,0,0"
                        Height="60">

                    <TextBlock Text="Add Custom Rate  ＋"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="19"
                               TextAlignment="Center" />
                </Button>
            </DockPanel>


            <Border Background="White"
                    CornerRadius="16"
                    Padding="24"
                    SnapsToDevicePixels="True"
                    Grid.Row="1"
                    Margin="0,22,0,-22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,12,0,24">


                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>

                        <!-- ────── Overhead ────── -->
                        <Grid Grid.Column="0"
                              Height="46">
                            <!-- textbox -->
                            <TextBox Style="{StaticResource HollowBox}"
                                     Background="#F5F5F5"
                                     Padding="14,0,34,0"
                                     Text="{Binding OverheadPercent, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- % sign -->
                            <TextBlock Text="%"
                                       FontWeight="SemiBold"
                                       Foreground="#5F6D7E"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                        </Grid>


                        <!-- ────── Profit ────── -->
                        <Grid Grid.Column="2"
                              Height="46">
                            <TextBox Style="{StaticResource HollowBox}"
                                     Background="#F5F5F5"
                                     Padding="14,0,34,0"
                                     Text="{Binding ProfitPercent,UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="%"
                                       FontWeight="SemiBold"
                                       Foreground="#5F6D7E"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                        </Grid>


                        <!-- ────── Search ────── -->
                        <Grid Grid.Column="4"
                              Height="46">
                            <TextBox Style="{StaticResource HollowBox}"
                                     Tag="Search description…"
                                     Padding="44,0,12,0"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- search icon -->
                            <TextBlock Text=""
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       Foreground="#9AA6B4" />
                        </Grid>

                        <!-- ────── Buttons ────── -->
                        <Button Grid.Column="6"
                                Content="Filter ⌄"
                                Command="{Binding FilterCommand}"
                                Style="{StaticResource RectButton}" />

                        <Button Grid.Column="8"
                                Content="Sort by ⌄"
                                Style="{StaticResource RectButton}"
                                Command="{Binding SortCommand}" />


                    </Grid>

                    <!-- 3. Rate Data -->

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FinishesCollectionView}"
                              Style="{StaticResource DataGridStyle}">


                        <DataGrid.Columns>
                            <DataGridTextColumn Header="S/N"
                                                Binding="{Binding ItemNo}"
                                                Width="60" />
                            <DataGridTemplateColumn Header="Description"
                                                    Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Blue900Brush}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ShowDetailsCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>



                            <DataGridTextColumn Header="Unit"
                                                Binding="{Binding Unit}"
                                                Width="90" />
                            <DataGridTextColumn Header="Net Cost"
                                                Binding="{Binding NetCost,   Converter={StaticResource MoneyConv},   StringFormat=N2}"
                                                Width="110" />
                            <DataGridTextColumn Header="Profit"
                                                Binding="{Binding ProfitValue,  Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                Width="110" />
                            <DataGridTextColumn Header="Overhead"
                                                Binding="{Binding OverheadValue,  Converter={StaticResource MoneyConv},StringFormat=N2}"
                                                Width="110" />
                            <DataGridTextColumn Header="Total Cost"
                                                Binding="{Binding TotalCost,  Converter={StaticResource MoneyConv},  StringFormat=N2}"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    
