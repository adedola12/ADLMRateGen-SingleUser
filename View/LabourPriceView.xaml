<UserControl x:Class="ADLMRateGen.View.LabourPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Input Form -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Section -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid fills the remaining space -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Input Labour Work Items with Prices" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Input all necessary information" FontSize="15"/>
        </StackPanel>

        <!-- 2. Input Form -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>

                </Grid.ColumnDefinitions>

                <!-- Labour Name -->
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Labour Name" FontSize="15" FontWeight="DemiBold"/>
                    <TextBox Text="{Binding LabourName, UpdateSourceTrigger=PropertyChanged}" Height="30">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="IsReadOnly" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="IsReadOnly" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>


                <!-- Material Unit -->
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Labour Unit" FontSize="15" FontWeight="DemiBold"/>
                    <TextBox Text="{Binding LabourUnit, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                </StackPanel>


            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>



                <!-- Material Price -->
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Labour Price" FontSize="15" FontWeight="DemiBold"/>
                    <TextBox Text="{Binding LabourPrice, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                </StackPanel>

                <!-- Material Category -->
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Labour Category" FontSize="15" FontWeight="DemiBold"/>
                    <TextBox Text="{Binding NewLabourCategory, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                </StackPanel>

                <!-- Save Button (visible when not editing) -->
                <Button Grid.Column="2" Content="Save to Database" 
             Command="{Binding SaveLabourCommand}" Height="40" FontSize="15" FontWeight="DemiBold" 
             VerticalAlignment="Center" Margin="5">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Update Button (visible when editing) -->
                <Button Grid.Column="3" Content="Update Material" 
             Command="{Binding UpdateLabourCommand}" Height="40" FontSize="15" FontWeight="DemiBold" 
             VerticalAlignment="Center" Margin="5">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

        </Grid>


    </Grid>
</UserControl>
