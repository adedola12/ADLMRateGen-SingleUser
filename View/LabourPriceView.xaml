<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ADLMRateGen.View.LabourPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="600">

    <!-- ─────────────── Resources ─────────────── -->
    <UserControl.Resources>

        <!-- Converters -->
        <conv:BoolToStringConverter  x:Key="BoolToStringConverter" />
        <conv:BoolToCommandConverter x:Key="BoolToCommandConverter" />

        <!-- Rounded TextBox -->
        <Style x:Key="RoundedTextBox"
               TargetType="TextBox">
            <Setter Property="Background"
                    Value="#EDF2F7" />
            <Setter Property="BorderBrush"
                    Value="#CBD5E0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="12" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Button -->
        <Style x:Key="RoundedButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#1A202C" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Height"
                    Value="48" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#111A2B" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- ─────────────── Layout ─────────────── -->
    <Grid Background="Transparent"
          Margin="20">

        <Border Background="White"
                CornerRadius="16"
                Padding="24"
                SnapsToDevicePixels="True">

            <Grid>

                <!-- Row layout -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Title -->
                    <RowDefinition Height="Auto" />
                    <!-- Subtitle -->
                    <RowDefinition Height="16" />
                    <!-- Spacer -->
                    <RowDefinition Height="Auto" />
                    <!-- Form -->
                    <RowDefinition Height="16" />
                    <!-- Spacer -->
                    <RowDefinition Height="Auto" />
                    <!-- Save/Update Button -->
                </Grid.RowDefinitions>

                <!-- 1) Title -->
                <TextBlock Grid.Row="0"
                           Text="{Binding IsEditing,
                                          Converter={StaticResource BoolToStringConverter},
                                          ConverterParameter='Update Library|Add New Labour'}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1A202C"
                           HorizontalAlignment="Center" />

                <!-- 2) Subtitle -->
                <TextBlock Grid.Row="1"
                           Text="Can’t find your desired labour item in our library?"
                           FontSize="14"
                           Foreground="#4A5568"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />

                <!-- 3) Input form -->
                <Border Grid.Row="3"
                        Background="#F2F6FF"
                        CornerRadius="8"
                        Padding="16">

                    <Grid>

                        <!-- Form rows -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- name -->
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <!-- unit/price -->
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <!-- category -->
                        </Grid.RowDefinitions>

                        <!-- Form columns -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!-- Labour Name -->
                        <StackPanel Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Margin="4,0">
                            <TextBlock Text="Name of Labour Item"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2D3748" />
                            <TextBox Text="{Binding LabourName, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox"
                                           BasedOn="{StaticResource RoundedTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}"
                                                         Value="True">
                                                <Setter Property="IsReadOnly"
                                                        Value="True" />
                                                <Setter Property="Foreground"
                                                        Value="#888" />
                                                <Setter Property="Background"
                                                        Value="#F4F4F4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <!-- Unit -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="4,0">
                            <TextBlock Text="Unit"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2D3748" />
                            <TextBox Text="{Binding LabourUnit}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox"
                                           BasedOn="{StaticResource RoundedTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}"
                                                         Value="True">
                                                <Setter Property="IsReadOnly"
                                                        Value="True" />
                                                <Setter Property="Foreground"
                                                        Value="#888" />
                                                <Setter Property="Background"
                                                        Value="#F4F4F4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <!-- Price -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="4,0">
                            <TextBlock Text="Price"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2D3748" />
                            <TextBox Style="{StaticResource RoundedTextBox}"
                                     Text="{Binding LabourPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Height="48" />
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Margin="4,0">
                            <TextBlock Text="Category"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2D3748" />
                            <TextBox Text="{Binding NewLabourCategory}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox"
                                           BasedOn="{StaticResource RoundedTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}"
                                                         Value="True">
                                                <Setter Property="IsReadOnly"
                                                        Value="True" />
                                                <Setter Property="Foreground"
                                                        Value="#888" />
                                                <Setter Property="Background"
                                                        Value="#F4F4F4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- 4) Save / Update Button -->
                <Button Grid.Row="5"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        Content="{Binding IsEditing,
                                          Converter={StaticResource BoolToStringConverter},
                                          ConverterParameter='Update Library|Save to Database'}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource RoundedButton}">
                            <Setter Property="Command"
                                    Value="{Binding SaveLabourCommand}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}"
                                             Value="True">
                                    <Setter Property="Command"
                                            Value="{Binding UpdateLabourCommand}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>
        </Border>
    </Grid>
</UserControl>
