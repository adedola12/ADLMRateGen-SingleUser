<UserControl x:Class="ADLMRateGen.View.CustomRateEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource CellTextBrush}" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource Mont}" />
        </Style>

        <Style x:Key="FormLabelTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource Blue900Brush}" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource Mont}" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>

        <Style x:Key="InlineHintTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource HintGrey}" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource Mont}" />
            <Setter Property="FontSize"
                    Value="11" />
        </Style>

        <Style x:Key="FormEditorComboStyle"
               TargetType="ComboBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource CellTextBrush}" />
            <Setter Property="TextElement.Foreground"
                    Value="{DynamicResource CellTextBrush}" />
            <Setter Property="Background"
                    Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="10,0" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource Mont}" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Height"
                    Value="46" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="TotalsTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Blue900Brush}" />
            <Setter Property="Margin"
                    Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BackgroundBrush}"
            Margin="25,-20"
            CornerRadius="20">

        <Grid>
            <Grid.RowDefinitions>
                <!-- 1. Header -->
                <RowDefinition Height="Auto" />
                <!-- 2. Top Input Row (Rate Name, Description, Overhead, Profit) -->
                <RowDefinition Height="Auto" />
                <!-- 3. Materials and Labour items -->
                <RowDefinition Height="*" />
                <!-- 4. Save Button -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,30,0,20"
                        HorizontalAlignment="Center">
                <TextBlock Text="Build New Custom Rate"
                           Style="{StaticResource EstHeader}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Enter rate name, overhead, profit, and items"
                           Style="{StaticResource SubheadingText}"
                           HorizontalAlignment="Center" />
            </StackPanel>


            <ScrollViewer  Grid.Row="2"
                           Margin="20,20,20,10"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled"
                           PanningMode="VerticalOnly"
                           CanContentScroll="True">
                <StackPanel>
                    <!-- Top Inputs -->
                    <StackPanel Grid.Row="1"
                                Margin="20,0,20,0">
                        
                        <Grid Margin="0,10,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Name of Rate -->
                            <StackPanel>
                                <TextBlock Text="Name of Rate"
                                           Style="{StaticResource FormLabelTextStyle}" />
                                <TextBox Style="{StaticResource OPTextBox}"
                                         Text="{Binding RateName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Description -->
                            <StackPanel Grid.Column="1"
                                        Margin="10,0">
                                <TextBlock Text="Description"
                                           Style="{StaticResource FormLabelTextStyle}" />
                                <TextBox Style="{StaticResource OPTextBox}"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="50" />
                            </StackPanel>
                        </Grid>
                        <!-- Overhead & Profit -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,10">
                            <StackPanel Width="180">
                                <TextBlock Text="Overhead"
                                           Style="{StaticResource FormLabelTextStyle}" />
                                <Grid>
                                    <TextBox Style="{StaticResource HollowBox}"
                                             Text="{Binding OverheadPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="%"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,12,0"
                                               FontFamily="{StaticResource Mont}"
                                               Foreground="{DynamicResource Grey700}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Width="180"
                                        Margin="20,0,0,0">
                                <TextBlock Text="Profit"
                                           Style="{StaticResource FormLabelTextStyle}" />
                                <Grid>
                                    <TextBox Style="{StaticResource OPTextBox}"
                                             Text="{Binding ProfitPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="%"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,12,0"
                                               FontFamily="{StaticResource Mont}"
                                               Foreground="{DynamicResource Grey700}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>


                    </StackPanel>

                    <!-- 3. Materials and Labour items -->


                    <StackPanel>
                        <!-- Materials Section Header with Button -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Materials"
                                           Style="{StaticResource Body}" />
                                <TextBlock Text="Click to add new material"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource InlineHintTextStyle}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Add Material"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding AddMaterialItemCommand}" />
                        </Grid>

                        <!-- Material Items -->
                        <ItemsControl ItemsSource="{Binding MaterialItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,10"
                                            Padding="8"
                                            CornerRadius="12"
                                            Background="{DynamicResource LightGrayBrush}">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Name -->
                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,8,0">
                                                <TextBlock Text="Name"
                                                           Style="{StaticResource InlineHintTextStyle}" />
                                                <ComboBox IsEditable="True"
                                                          Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          ItemsSource="{Binding DataContext.AvailableMaterials, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          HorizontalContentAlignment="Left"
                                                          MinWidth="180"
                                                          Style="{StaticResource FormEditorComboStyle}" />
                                            </StackPanel>

                                            <!-- Rate -->
                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0">
                                                <TextBlock Text="Rate"
                                                           Style="{StaticResource InlineHintTextStyle}" />
                                                <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Style="{StaticResource OPTextBox}" />
                                            </StackPanel>

                                            <!-- Unit -->
                                            <StackPanel Grid.Column="2"
                                                        Margin="8,0">
                                                <TextBlock Text="Unit"
                                                           Style="{StaticResource InlineHintTextStyle}" />
                                                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Width="50"
                                                         FontFamily="{DynamicResource Mont}"
                                                         Style="{StaticResource OPTextBox}"
                                                         FontSize="14"
                                                         Padding="10,0"
                                                         Background="{DynamicResource BackgroundBrush}"
                                                         Foreground="{DynamicResource CellTextBrush}"
                                                         BorderBrush="{DynamicResource BorderBrushLight}"
                                                         BorderThickness="1"
                                                         VerticalContentAlignment="Center"
                                                         HorizontalContentAlignment="Center"
                                                         Height="46" />
                                            </StackPanel>

                                            <!-- Quantity -->
                                            <StackPanel Grid.Column="3"
                                                        Margin="8,0">
                                                <TextBlock Text="Quantity"
                                                           Style="{StaticResource InlineHintTextStyle}" />
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Style="{StaticResource OPTextBox}" />
                                            </StackPanel>

                                            <!-- Amount -->
                                            <StackPanel Grid.Column="4"
                                                        Margin="8,0">
                                                <TextBlock Text="Amount"
                                                           Style="{StaticResource InlineHintTextStyle}" />
                                                <TextBlock Text="{Binding TotalCost, StringFormat=N2}"
                                                           Style="{StaticResource CenterCellText}"
                                                           Margin="0,12,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>




                        <!-- Labour Section -->
                       

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Labour"
                                           Style="{StaticResource Body}" />
                                <TextBlock Text="Click to add new labour"
                                           Margin="10,0"
                                           Style="{StaticResource InlineHintTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Content="Add Labour"
                                    Grid.Column="1"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddLabourItemCommand}" />


                        </Grid>


                        <ItemsControl ItemsSource="{Binding LabourItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,10"
                                            Padding="8"
                                            CornerRadius="12"
                                            Background="{DynamicResource LightGrayBrush}">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Name -->
                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,8,0">
                                                <TextBlock Text="Name"
                                                           Style="{StaticResource InlineHintTextStyle}" />
                                                <ComboBox IsEditable="True"
                                                          IsTextSearchEnabled="True"
                                                          StaysOpenOnEdit="True"
                                                          Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          ItemsSource="{Binding DataContext.AvailableLabourItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          HorizontalContentAlignment="Left"
                                                          MinWidth="180"
                                                          Style="{StaticResource FormEditorComboStyle}" />
                                                <!--<TextBlock Text="{Binding DataContext.AvailableLabourItems.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" />-->


                                            </StackPanel>

                                            <!-- Rate -->
                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0">
                                                <TextBlock Text="Rate"
                                                           Style="{StaticResource InlineHintTextStyle}" />
                                                <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Style="{StaticResource OPTextBox}" />
                                            </StackPanel>

                                            <!-- Unit -->
                                            <StackPanel Grid.Column="2"
                                                        Margin="8,0">
                                                <TextBlock Text="Unit"
                                                           Style="{StaticResource InlineHintTextStyle}" />
                                                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Width="50"
                                                         FontFamily="{DynamicResource Mont}"
                                                         Style="{StaticResource OPTextBox}"
                                                         FontSize="14"
                                                         Padding="10,0"
                                                         Background="{DynamicResource BackgroundBrush}"
                                                         Foreground="{DynamicResource CellTextBrush}"
                                                         BorderBrush="{DynamicResource BorderBrushLight}"
                                                         BorderThickness="1"
                                                         VerticalContentAlignment="Center"
                                                         HorizontalContentAlignment="Center"
                                                         Height="46" />
                                            </StackPanel>

                                            <!-- Quantity -->
                                            <StackPanel Grid.Column="3"
                                                        Margin="8,0">
                                                <TextBlock Text="Quantity"
                                                           Style="{StaticResource InlineHintTextStyle}" />
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         Style="{StaticResource OPTextBox}" />
                                            </StackPanel>

                                            <!-- Amount -->
                                            <StackPanel Grid.Column="4"
                                                        Margin="8,0">
                                                <TextBlock Text="Amount"
                                                           Style="{StaticResource InlineHintTextStyle}" />
                                                <TextBlock Text="{Binding TotalCost, StringFormat=N2}"
                                                           Style="{StaticResource CenterCellText}"
                                                           Margin="0,12,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                       
                        <!-- Totals -->
                        <TextBlock Text="{Binding TotalMaterialCost, StringFormat='Material Total: {0:N2}'}"
                                   Style="{StaticResource TotalsTextStyle}"
                                   Margin="0,20,0,0" />
                        <TextBlock Text="{Binding TotalLabourCost, StringFormat='Labour Total: {0:N2}'}"
                                   Style="{StaticResource TotalsTextStyle}" />
                        <TextBlock Text="{Binding OverallTotal, StringFormat='Overall Total: {0:N2}'}"
                                   Style="{StaticResource TotalsTextStyle}" />

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
            
            
            <!-- Save Button -->
            <Button Grid.Row="3"
                    Margin="0,20,0,0"
                    Height="50"
                    FontSize="16"
                    FontFamily="{DynamicResource Mont}"
                    Foreground="White"
                    Background="#061E3D"
                    Command="{Binding SaveCustomRateCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Setter Property="Content"
                                Value="Save" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}"
                                         Value="True">
                                <Setter Property="Content"
                                        Value="Update" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>



        </Grid>
    </Border>
</UserControl>
