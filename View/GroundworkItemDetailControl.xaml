<UserControl x:Class="ADLMRateGen.View.GroundworkItemDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="820">

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="24"
            Padding="56,54"
            SnapsToDevicePixels="True"
            MaxHeight="700">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,37">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Click="BackButton_Click" Cursor="Hand"
                            VerticalAlignment="Center" Margin="0,0,5,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Path Data="M15,3 L6,12 L15,21"
                                      Stroke="{DynamicResource HintGrey}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="26" Height="26"
                                      Stretch="Uniform" Margin="4" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="Rate Composition"
                               FontFamily="{DynamicResource Mont}"
                               FontSize="36" FontWeight="Bold"
                               Foreground="{DynamicResource HintGrey}" />
                </StackPanel>

                <TextBlock Text="{Binding Description}"
                           FontFamily="{DynamicResource Mont}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Blue900Brush}"
                           TextWrapping="Wrap"
                           MaxWidth="664"
                           HorizontalAlignment="Left" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="{DynamicResource HeaderBgBrush}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Component"
                                       FontFamily="{DynamicResource PoppinsFont}"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource Blue900Brush}" Padding="10,0" />
                            <TextBlock Grid.Column="1" Text="Quantity"
                                       FontFamily="{DynamicResource PoppinsFont}"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource Blue900Brush}" TextAlignment="Right" Padding="10,0" />
                            <TextBlock Grid.Column="2" Text="Unit"
                                       FontFamily="{DynamicResource PoppinsFont}"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource Blue900Brush}" TextAlignment="Right" Padding="10,0" />
                            <TextBlock Grid.Column="3" Text="Unit Price"
                                       FontFamily="{DynamicResource PoppinsFont}"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource Blue900Brush}" TextAlignment="Right" Padding="10,0" />
                            <TextBlock Grid.Column="4" Text="Total Cost"
                                       FontFamily="{DynamicResource PoppinsFont}"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource Blue900Brush}" TextAlignment="Right" Padding="10,0" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding BreakdownLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ComponentName}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="16" Foreground="{DynamicResource Blue900Brush}"
                                                   TextWrapping="Wrap" Padding="10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTotalLine}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Quantity}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="16" FontWeight="Medium"
                                                   Foreground="{DynamicResource Blue900Brush}"
                                                   TextAlignment="Right" Padding="10,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Unit}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="16" FontWeight="Medium"
                                                   Foreground="{DynamicResource Blue900Brush}"
                                                   TextAlignment="Right" Padding="10,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding UnitPrice, Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="16" FontWeight="Medium"
                                                   Foreground="{DynamicResource Blue900Brush}"
                                                   TextAlignment="Right" Padding="10,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding TotalPrice, Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="16" FontWeight="Medium"
                                                   Foreground="{DynamicResource Blue900Brush}"
                                                   TextAlignment="Right" Padding="10,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Rectangle Height="1.5" Fill="{DynamicResource DivBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
