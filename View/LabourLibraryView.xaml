<UserControl x:Class="ADLMRateGen.View.LabourLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">

    <Border BorderBrush="{StaticResource PrimaryBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12"
            Background="{StaticResource BackgroundBrush}">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ─── Toolbar ─────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource LightGrayBrush}"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,16">
                <Grid VerticalAlignment="Center"
                      Margin="10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- search box -->
                    <Grid Grid.Column="0">
                        <TextBox Style="{StaticResource HollowBox}"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="32,0,48,0" />
                        <TextBlock Text=""
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{StaticResource BorderBrushLight}" />
                        <TextBlock Text="⌘F"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource BorderBrushLight}" />
                    </Grid>

                    <!-- category filter -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LabourCategory}"
                              SelectedItem="{Binding SelectedLabourCategory, Mode=TwoWay}"
                              Style="{StaticResource TopNavComboBoxStyle}"
                              Width="100"
                              Margin="12,0" />

                    <!-- sort placeholder -->
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Sort by ▼"
                            Width="100"
                            Margin="0,0,12,0" />

                    <Rectangle Grid.Column="3"
                               Fill="Transparent" />

                    <!-- update prices -->
                    <Button Grid.Column="4"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding UpdatePricesCommand}"
                            Content="Update Prices"
                            Width="150" />
                </Grid>
            </Border>

            <!-- ─── DataGrid ─────────────────────────── -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding LabourCollectionView}"
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="S/N"
                                        Binding="{Binding SerialNumber}"
                                        Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTemplateColumn Header="Labour Item"
                                            Width="*">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LabourName}"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource PoppinsFont}"
                                           Foreground="{StaticResource Blue900Brush}">
                                    <TextBlock.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                     
                                                      Command="{Binding DataContext.EditLabourCommand,
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                   
                    <DataGridTextColumn Header="Labour Unit"
                                        Binding="{Binding LabourUnit}"
                                        Width="120" />

                    <DataGridTextColumn Header="Price"
                                        Binding="{Binding DisplayPrice, Converter={StaticResource MoneyConv},
                                      Mode=OneWay,
                                      StringFormat={}{0:N2}}"
                                        Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Left" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding LabourCategory}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Center" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
