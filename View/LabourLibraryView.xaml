<UserControl x:Class="ADLMRateGen.View.LabourLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Section -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid fills the remaining space -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="All Labour Items with Prices" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="All necessary information" FontSize="15"/>
        </StackPanel>

        <!-- 3. Filter Section -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"  VerticalAlignment="Center" Margin="5">
                <TextBlock Text="Select Labour Category:" FontSize="15" FontWeight="DemiBold" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding LabourCategory}"
                          SelectedItem="{Binding SelecctedLabourCategory, Mode=TwoWay}"
                           Height="30" Width="150" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
            
            <!-- Search -->
            <StackPanel Grid.Column="1" Margin="5">
                <TextBlock Text="Search Name" FontSize="15" FontWeight="DemiBold"/>
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
            </StackPanel>

            <!--<Button Grid.Column="2" Content="Search" 
                    Command="{Binding SearchLabourCommand}" 
                    Margin="5,5,41,5" 
                    Height="40" FontSize="15" FontWeight="DemiBold"/>-->

        </Grid>
     

        <!-- 4. DataGrid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding LabourCollectionView}" 
        AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,10,0,10" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="S/N" Binding="{Binding SerialNumber}" Width="Auto"/>
                <DataGridTextColumn Header="Labour Item Name" Binding="{Binding LabourName}" Width="*"/>
                <DataGridTextColumn Header="Labour Unit" Binding="{Binding LabourUnit}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding LabourPrice, StringFormat=N2}" Width="Auto"/>
                <DataGridTextColumn Header="Category" Binding="{Binding LabourCategory}" Width="*"/>

                <DataGridTemplateColumn Header="Edit" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Edit" 
                Command="{Binding DataContext.EditLabourCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                CommandParameter="{Binding}"
                Width="50" Height="30" ToolTip="Edit this entry"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--<DataGridTemplateColumn Header="Delete" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="X" 
                Command="{Binding DataContext.DeleteLabourCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                CommandParameter="{Binding}"
                Width="30" Height="30" ToolTip="Delete this entry"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
