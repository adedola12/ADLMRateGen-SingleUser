<UserControl x:Class="ADLMRateGen.View.SignInUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             d:DesignWidth="1024"
             d:DesignHeight="900">

    <UserControl.Resources>
        <Style x:Key="SignInLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#E6F0FF" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource Mont}" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>

        <Style x:Key="SignInFieldTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource HollowBox}">
            <Setter Property="Background"
                    Value="{DynamicResource BgInput}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness"
                    Value="1.2" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Blue900Brush}" />
            <Setter Property="CaretBrush"
                    Value="{DynamicResource SignInBrush}" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="Height"
                    Value="56" />
            <Setter Property="Padding"
                    Value="20,0" />
        </Style>

        <Style x:Key="SignInPasswordBoxStyle"
               TargetType="PasswordBox">
            <Setter Property="Background"
                    Value="{DynamicResource BgInput}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness"
                    Value="1.2" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Blue900Brush}" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource Mont}" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="Height"
                    Value="56" />
            <Setter Property="Padding"
                    Value="20,0,60,0" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SignInTextLinkButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Foreground"
                    Value="#E7F1FF" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource Mont}" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource SignInBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SignInLoginButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource SignInBrush}" />
            <Setter Property="BorderBrush"
                    Value="#8DBAFF" />
            <Setter Property="BorderThickness"
                    Value="1.2" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="Width"
                    Value="560" />
            <Setter Property="Height"
                    Value="62" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ShadowLayer"
                                    Margin="0,8,0,0"
                                    CornerRadius="18"
                                    Background="#182A4A"
                                    Opacity="0.92" />

                            <Border x:Name="Face"
                                    Margin="0"
                                    CornerRadius="18"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="4"
                                                      Color="#4C8DFF"
                                                      Opacity="0.34" />
                                </Border.Effect>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="18,0"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Face"
                                        Property="Margin"
                                        Value="0,-4,0,4" />
                                <Setter TargetName="ShadowLayer"
                                        Property="Margin"
                                        Value="0,12,0,0" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Face"
                                        Property="Margin"
                                        Value="0,2,0,-2" />
                                <Setter TargetName="ShadowLayer"
                                        Property="Opacity"
                                        Value="0.44" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                                <Setter TargetName="Face"
                                        Property="Opacity"
                                        Value="0.58" />
                                <Setter TargetName="ShadowLayer"
                                        Property="Opacity"
                                        Value="0.28" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}"
                             Value="True">
                    <Setter Property="IsEnabled"
                            Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Background="Transparent">
        <Grid x:Name="LayoutRoot"
              MinHeight="760"
              Background="Transparent">
            <Grid Margin="24"
                  ClipToBounds="False">
                <Grid MaxWidth="980"
                      MinWidth="320"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ClipToBounds="False">
                    <Border x:Name="SignInCard"
                            Width="920"
                            MinHeight="620"
                            Padding="54,34,54,30"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            CornerRadius="32"
                            BorderBrush="{DynamicResource SignInBrush}"
                            BorderThickness="1.6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32"
                                              Color="{StaticResource SignInCol}"
                                              ShadowDepth="0"
                                              Opacity="0.36" />
                        </Border.Effect>

                        <Grid>
                            <Grid.Background>
                                <ImageBrush ImageSource="/Resources/panel_blueprint.png"
                                            Stretch="UniformToFill" />
                            </Grid.Background>

                            <Border CornerRadius="28"
                                    Background="#CC07172D" />

                            <Grid Margin="54,18,54,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Image Source="/Resources/adlm_studio_logo_small.png"
                                       Height="28"
                                       HorizontalAlignment="Center" />

                                <Image Grid.Row="1"
                                       Source="/Resources/adlm_rate_generator_logo.png"
                                       MaxHeight="160"
                                       Margin="0,28,0,30"
                                       HorizontalAlignment="Center"
                                       Stretch="Uniform" />

                                <StackPanel Grid.Row="2"
                                            Width="560"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Email or username"
                                               Style="{StaticResource SignInLabelStyle}" />

                                    <TextBox x:Name="EmailTextBox"
                                             Style="{StaticResource SignInFieldTextBoxStyle}"
                                             Width="560"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="Password"
                                               Style="{StaticResource SignInLabelStyle}"
                                               Margin="0,20,0,8" />

                                    <Grid Width="560">
                                        <PasswordBox x:Name="PasswordBox"
                                                     Style="{StaticResource SignInPasswordBoxStyle}"
                                                     PasswordChanged="PasswordBox_PasswordChanged" />

                                        <TextBox x:Name="PasswordPreviewTextBox"
                                                 Style="{StaticResource SignInFieldTextBoxStyle}"
                                                 Padding="20,0,60,0"
                                                 Visibility="Collapsed"
                                                 TextChanged="PasswordPreviewTextBox_TextChanged" />

                                        <Button Width="34"
                                                Height="34"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Focusable="False"
                                                ToolTip="Show or hide password"
                                                Click="TogglePwd_Click">
                                            <fa:IconBlock x:Name="PasswordToggleIcon"
                                                          Icon="Eye"
                                                          Width="18"
                                                          Height="18"
                                                          Foreground="{DynamicResource Blue900Brush}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <Button Grid.Row="3"
                                        Style="{StaticResource SignInLoginButtonStyle}"
                                        Command="{Binding LoginCommand}"
                                        HorizontalAlignment="Center"
                                        Margin="0,28,0,0">
                                    <TextBlock Text="Log in"
                                               FontFamily="{DynamicResource Mont}"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                </Button>

                                <StackPanel Grid.Row="4"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Center">
                                    <Button Content="Forgot password?"
                                            Style="{StaticResource SignInTextLinkButtonStyle}"
                                            Click="OpenForgotPassword_Click" />

                                    <TextBlock Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               FontFamily="{DynamicResource Mont}"
                                               FontSize="12"
                                               Foreground="#D8E6FF">
                                        <Run Text="Don't have an account? " />
                                        <Hyperlink Click="OpenSignUp_Click"
                                                   Foreground="{DynamicResource SignInBrush}">
                                            <Run Text="Create account" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Image Source="/Resources/bg_frame.png"
                           Width="126"
                           Height="150"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,-30,-34,0"
                           Panel.ZIndex="2"
                           Opacity="0.96"
                           IsHitTestVisible="False" />

                    <Image Source="/Resources/bg_frame.png"
                           Width="126"
                           Height="150"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="-34,0,0,-30"
                           Panel.ZIndex="2"
                           Opacity="0.96"
                           IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
