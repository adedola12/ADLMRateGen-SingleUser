<UserControl x:Class="ADLMRateGen.View.PaintworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <!-- ───────── LAYOUT ───────── -->
    <Border BorderThickness="2"
            BorderBrush="Transparent"
            CornerRadius="6"
            Padding="20,0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Paintwork Computation"
                               Style="{StaticResource EstHeader}"/>
                    <TextBlock Text="Using Material and Labour Prices from the Library"
                               Style="{StaticResource EstSubheader}" />
                </StackPanel>

                <!-- Add‑custom‑rate button -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonCus}"
                        Command="{Binding AddCustomRateCommand}"
                        Width="276"
                        Margin="580,0,0,0"
                       >

                    <!-- Explicit caption → always white -->
                    <TextBlock Text="Add Custom Rate  ＋"
                               Style="{StaticResource BtnText}" />
                </Button>
            </DockPanel>

            <Border Background="{StaticResource VeryLight}"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{StaticResource LightGrayBrush}"
                    Padding="24"
                    SnapsToDevicePixels="True"
                    Grid.Row="1"
                    Margin="0,22,0,-22">
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,10,0,10">
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>


                        <!-- ────── Overhead ────── -->
                        <Grid Grid.Column="0"
                              Height="46">
                            <!-- textbox -->
                            <TextBox Style="{StaticResource OPTextBox}"
                                     Text="{Binding OverheadPercent,UpdateSourceTrigger=PropertyChanged}" />

                            <!-- % sign -->
                            <TextBlock Style="{StaticResource OPText}" />
                        </Grid>


                        <!-- ────── Profit ────── -->
                        <Grid Grid.Column="2"
                              Height="46">
                            <TextBox Style="{StaticResource OPTextBox}"
                                     Text="{Binding ProfitPercent,UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource OPText}" />

                        </Grid>


                        <!-- ────── Search ────── -->
                        <Grid Grid.Column="4"
                              Height="46">
                            <TextBox Style="{StaticResource SearchBoxWithIcon}"
                                     Tag="Search description…"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />

                        </Grid>


                        <!-- ────── Buttons ────── -->
                        <Button Grid.Column="6"
                                Content="Filter ⌄"
                                Command="{Binding FilterCommand}"
                                Style="{StaticResource RectButton}" />

                        <Button Grid.Column="8"
                                Content="Sort by ⌄"
                                Style="{StaticResource RectButton}"
                                Command="{Binding SortCommand}" />


                    </Grid>

                    <!-- 3. Rate Data -->

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding PaintWorkCollectionView}"
                              Style="{StaticResource DataGridStyle}">


                        <DataGrid.Columns>
                            <DataGridTextColumn Header="S/N"
                                                Binding="{Binding ItemNo}"
                                                Width="60"
                                                ElementStyle="{StaticResource CenterCellNr}" />
                            
                            <DataGridTemplateColumn Header="Description"
                                                    Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Blue900Brush}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ShowDetailsCommand,
                                                     RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>



                            <DataGridTextColumn Header="Unit"
                                                Binding="{Binding Unit}"
                                                Width="90"
                                                ElementStyle="{StaticResource CenterCellNr}" />
                            <DataGridTextColumn Header="Net Cost"
                                                Binding="{Binding NetCost,  Converter={StaticResource MoneyConv},    StringFormat=N2}"
                                                Width="110"
                                                ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="Profit"
                                                Binding="{Binding ProfitValue, Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                Width="110"
                                                ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="Overhead"
                                                Binding="{Binding OverheadValue, Converter={StaticResource MoneyConv},StringFormat=N2}"
                                                Width="110"
                                                ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="Total Cost"
                                                Binding="{Binding TotalCost,   Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                Width="120"
                                                ElementStyle="{StaticResource CenterCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    
                </Grid>

            </Border>


        </Grid>
    </Border>
</UserControl>
