<UserControl x:Class="ADLMRateGen.View.BlockworkItemDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="820">

    <!-- ─── Figma: white card, border #DFE2E6, rounded 24, padding 56h/54v ─── -->
    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="24"
            Padding="56,54"
            SnapsToDevicePixels="True"
            MaxHeight="700">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <StackPanel Grid.Row="0" Margin="0,0,0,37">
                <!-- Back arrow + Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Click="BackButton_Click" Cursor="Hand"
                            VerticalAlignment="Center" Margin="0,0,5,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Path Data="M15,3 L6,12 L15,21"
                                      Stroke="{DynamicResource HintGrey}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="26" Height="26"
                                      Stretch="Uniform" Margin="4" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="Rate Composition"
                               FontFamily="{DynamicResource Mont}"
                               FontSize="36" FontWeight="Bold"
                               Foreground="{DynamicResource HintGrey}" />
                </StackPanel>

                <!-- Description -->
                <TextBlock Text="{Binding Description}"
                           FontFamily="{DynamicResource Mont}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Blue900Brush}"
                           TextWrapping="Wrap"
                           MaxWidth="664"
                           HorizontalAlignment="Left" />
            </StackPanel>

            <!-- ═══ TABLE ═══ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Header row -->
                    <Border Background="{DynamicResource HeaderBgBrush}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Component"
                                       FontFamily="{DynamicResource PoppinsFont}"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource Blue900Brush}" Padding="10,0" />
                            <TextBlock Grid.Column="1" Text="Quantity"
                                       FontFamily="{DynamicResource PoppinsFont}"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource Blue900Brush}" TextAlignment="Right" Padding="10,0" />
                            <TextBlock Grid.Column="2" Text="Unit"
                                       FontFamily="{DynamicResource PoppinsFont}"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource Blue900Brush}" TextAlignment="Right" Padding="10,0" />
                            <TextBlock Grid.Column="3" Text="Unit Price"
                                       FontFamily="{DynamicResource PoppinsFont}"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource Blue900Brush}" TextAlignment="Right" Padding="10,0" />
                            <TextBlock Grid.Column="4" Text="Total Cost"
                                       FontFamily="{DynamicResource PoppinsFont}"
                                       FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource Blue900Brush}" TextAlignment="Right" Padding="10,0" />
                        </Grid>
                    </Border>

                    <!-- Data rows -->
                    <ItemsControl ItemsSource="{Binding BlockworkBreakdownLine}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Background="Transparent"
                                                   Text="{Binding ComponentName}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="16" Foreground="{DynamicResource Blue900Brush}"
                                                   TextWrapping="Wrap" Padding="10,0">
                                            <!-- Click a component to open the library at the row it is
                                                 priced from. Underlined and hand-cursored only when the
                                                 name resolves to a library item, so totals, warnings and
                                                 percentage rows do not look clickable. -->
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding OpenInLibraryCommand}"
                                                              CommandParameter="{Binding ComponentName}" />
                                            </TextBlock.InputBindings>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanOpenInLibrary}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Underline" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTotalLine}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                                 IsEnabled="{Binding IsEditableQuantity}"
                                                 IsReadOnly="True"
                                                 MouseDoubleClick="QuantityTextBox_MouseDoubleClick"
                                                 LostFocus="QuantityTextBox_LostFocus"
                                                 FontFamily="{DynamicResource PoppinsFont}"
                                                 FontSize="16" FontWeight="Medium"
                                                 Foreground="{DynamicResource Blue900Brush}"
                                                 TextAlignment="Right" Padding="10,4"
                                                 VerticalAlignment="Center"
                                                 ToolTip="Double-click to edit quantity. Click out to save.">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsReadOnly" Value="False">
                                                            <Setter Property="Background" Value="#FFFBE5" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Blue900Brush}" />
                                                            <Setter Property="BorderThickness" Value="1.5" />
                                                            <Setter Property="Cursor" Value="IBeam" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.55" />
                                                            <Setter Property="Cursor" Value="Arrow" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Unit}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="16" FontWeight="Medium"
                                                   Foreground="{DynamicResource Blue900Brush}"
                                                   TextAlignment="Right" Padding="10,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding UnitPrice, Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="16" FontWeight="Medium"
                                                   Foreground="{DynamicResource Blue900Brush}"
                                                   TextAlignment="Right" Padding="10,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding TotalPrice, Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="16" FontWeight="Medium"
                                                   Foreground="{DynamicResource Blue900Brush}"
                                                   TextAlignment="Right" Padding="10,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- Row separator -->
                                    <Rectangle Height="1.5" Fill="{DynamicResource DivBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Save / Reset / Cancel footer for user Quantity edits -->
                    <Border Margin="0,16,0,0" Padding="10,12"
                            Background="{DynamicResource HeaderBgBrush}"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Edit any Quantity field above. Sub-totals refresh automatically."
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       FontFamily="{DynamicResource PoppinsFont}" FontSize="12"
                                       Foreground="{DynamicResource HintGrey}" />
                            <Button Content="Reset This Rate"
                                    Click="ResetThisRateButton_Click"
                                    Cursor="Hand"
                                    Padding="14,6" Margin="0,0,8,0"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource HintGrey}" BorderThickness="1"
                                    Foreground="{DynamicResource HintGrey}"
                                    FontFamily="{DynamicResource PoppinsFont}" FontSize="13"
                                    ToolTip="Restore the shipped default Quantities for this item." />
                            <Button Content="Cancel"
                                    Click="CancelButton_Click"
                                    Cursor="Hand"
                                    Padding="14,6" Margin="0,0,8,0"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource HintGrey}" BorderThickness="1"
                                    Foreground="{DynamicResource HintGrey}"
                                    FontFamily="{DynamicResource PoppinsFont}" FontSize="13"
                                    ToolTip="Discard unsaved edits in this session." />
                            <Button Content="Save"
                                    Click="SaveButton_Click"
                                    Cursor="Hand"
                                    Padding="18,6"
                                    Background="{DynamicResource Blue900Brush}"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontFamily="{DynamicResource PoppinsFont}" FontSize="13" FontWeight="SemiBold"
                                    ToolTip="Persist changes locally + sync to QUIV / HERON." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
