<UserControl x:Class="ADLMRateGen.View.MaterialPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600"
             FontFamily="Poppins">

    <UserControl.Resources>
        <!-- converters -->
        <conv:BoolToStringConverter  x:Key="BoolToStringConverter" />
        <conv:BoolToCommandConverter x:Key="BoolToCommandConverter" />

        <!-- Rounded TextBox -->
        <Style x:Key="RoundedTextBox"
               TargetType="TextBox">
            <Setter Property="Background"
                    Value="#EDF2F7" />
            <Setter Property="BorderBrush"
                    Value="#CBD5E0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="12" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Button -->
        <Style x:Key="RoundedButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#1A202C" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Height"
                    Value="48" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#111A2B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- outer margin -->
    <Grid Margin="24"
          Background="Transparent">
        <Border Background="White"
                CornerRadius="16"
                Padding="24"
                SnapsToDevicePixels="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- title -->
                    <RowDefinition Height="Auto" />
                    <!-- subtitle -->
                    <RowDefinition Height="16" />
                    <!-- spacer -->
                    <RowDefinition Height="Auto" />
                    <!-- form -->
                    <RowDefinition Height="16" />
                    <!-- spacer -->
                    <RowDefinition Height="Auto" />
                    <!-- button -->
                </Grid.RowDefinitions>

                <!-- 1) Title -->
                <TextBlock Grid.Row="0"
                           Text="{Binding IsEditing,
                     Converter={StaticResource BoolToStringConverter},
                     ConverterParameter='Update Library|Add New Material'}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1A202C"
                           HorizontalAlignment="Center" />

                <!-- 2) Subtitle -->
                <TextBlock Grid.Row="1"
                           Text="Can’t find your desired material in our library?"
                           FontSize="14"
                           Foreground="#4A5568"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />

                <!-- 3) Form background -->
                <Border Grid.Row="3"
                        Background="#F2F6FF"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- name -->
                            <RowDefinition Height="16" />
                            <!-- spacer -->
                            <RowDefinition Height="Auto" />
                            <!-- unit/price -->
                            <RowDefinition Height="16" />
                            <!-- spacer -->
                            <RowDefinition Height="Auto" />
                            <!-- category -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!-- Name (full width) -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="4,0">
                            <TextBlock Text="Name of Material"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2D3748" />
                            <TextBox Style="{StaticResource RoundedTextBox}"
                                     Text="{Binding MaterialName}"
                                     Height="48" />
                        </StackPanel>

                        <!-- Unit -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="4,0">
                            <TextBlock Text="Unit"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2D3748" />
                            <TextBox Style="{StaticResource RoundedTextBox}"
                                     Text="{Binding MaterialUnit}"
                                     Height="48" />
                        </StackPanel>

                        <!-- Price -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="4,0">
                            <TextBlock Text="Price"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2D3748" />
                            <TextBox Style="{StaticResource RoundedTextBox}"
                                     Text="{Binding MaterialPrice}"
                                     Height="48" />
                        </StackPanel>

                        <!-- Category (full width) -->
                        <StackPanel Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="4,0">
                            <TextBlock Text="Category"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2D3748" />
                            <TextBox Style="{StaticResource RoundedTextBox}"
                                     Text="{Binding NewMaterialCategory}"
                                     Height="48" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4) Save/Update Button -->
                <Button Grid.Row="5"
                        Style="{StaticResource RoundedButton}"
                        Content="{Binding IsEditing,
                  Converter={StaticResource BoolToStringConverter},
                  ConverterParameter='Update Library|Save to Database'}"
                        Command="{Binding IsEditing,
                  Converter={StaticResource BoolToCommandConverter},
                  ConverterParameter='UpdateMaterial|SaveMaterial'}"
                        HorizontalAlignment="Stretch" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
