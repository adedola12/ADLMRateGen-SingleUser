<UserControl x:Class="ADLMRateGen.View.MaterialPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="700"
             Height="770"
             FontFamily="Poppins">

    <UserControl.Resources>
        <!-- converters -->
        <conv:BoolToStringConverter  x:Key="BoolToStringConverter" />
        <conv:BoolToCommandConverter x:Key="BoolToCommandConverter" />


    </UserControl.Resources>

    <!-- outer margin -->
    <Grid Margin="10"
          Background="Transparent">

        <Border Background="White"
                CornerRadius="16"
                Padding="24"
                SnapsToDevicePixels="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- title -->
                    <RowDefinition Height="Auto" />
                    <!-- subtitle -->
                    <RowDefinition Height="16" />
                    <!-- spacer -->
                    <RowDefinition Height="Auto" />
                    <!-- form -->
                    <RowDefinition Height="16" />
                    <!-- spacer -->
                    <RowDefinition Height="Auto" />
                    <!-- button -->
                </Grid.RowDefinitions>

                <!-- 1) Title -->
                <TextBlock Grid.Row="0"
                           Text="{Binding IsEditing,
                     Converter={StaticResource BoolToStringConverter},
                     ConverterParameter='Update Library|Add New Material'}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource Blue900Brush}"
                           HorizontalAlignment="Center" />

                <!-- 2) Subtitle -->
                <TextBlock Grid.Row="1"
                           Text="Can’t find your desired material in our library?"
                           FontSize="16"
                           FontWeight="DemiBold"
                           Foreground="{StaticResource Grey700}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />

                <!-- 3) Form background -->
                <Border Grid.Row="3"
                        Background="{StaticResource BgInput}"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- name -->
                            <RowDefinition Height="16" />
                            <!-- spacer -->
                            <RowDefinition Height="Auto" />
                            <!-- unit/price -->
                            <RowDefinition Height="16" />
                            <!-- spacer -->
                            <RowDefinition Height="Auto" />
                            <!-- category -->
                        </Grid.RowDefinitions>



                        <!-- Name (full width) -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="4,10">
                            <TextBlock Text="Name of Material"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Grey700}"
                                       Margin="0,10" />
                            <!-- inside your form – Name textbox -->
                            <TextBox Text="{Binding MaterialName}"
                                     Style="{StaticResource TBInput}" />



                        </StackPanel>

                        <!-- wrap both fields in one grid -->
                        <Grid Grid.Row="2"
                              Margin="4,0,4,0">
                            <!-- two equal columns -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: labels -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Unit label -->
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Unit"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Grey700}"
                                       Margin="0,0,0,4" />

                            <!-- Price label -->
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="Price"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Grey700}"
                                       Margin="20,0,0,4" />

                            <!-- Unit textbox -->
                            <TextBox Grid.Row="1"
                                     Grid.Column="0"
                                     Text="{Binding MaterialUnit}"
                                     Style="{StaticResource TBInput}"
                                     Margin="0,0,8,0" />

                            <!-- Price textbox -->
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding MaterialPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TBInput}"
                                     Margin="18,0,8,0" />
                        </Grid>


                        <!-- Category (full width) -->
                        <StackPanel Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="4,10">
                            <TextBlock Text="Category"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Grey700}"
                                       Margin="0,10" />

                            <TextBox Text="{Binding NewMaterialCategory}"
                                     Style="{StaticResource TBInput}" />


                        </StackPanel>
                    </Grid>
                </Border>


                <!-- 4) Save / Update Button -->
                <Button Grid.Row="5"
                       
                        Content="{Binding IsEditing,
                  Converter={StaticResource BoolToStringConverter},
                  ConverterParameter='Update Library|Save to Database'}"
                        HorizontalAlignment="Stretch">

                    <!-- base look + trigger that switches command -->
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource PrimaryButtonCus}">
                            <!-- default: add -->
                            <Setter Property="Command"
                                    Value="{Binding SaveMaterialCommand}" />
                            <!-- when editing: switch to update -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}"
                                             Value="True">
                                    <Setter Property="Command"
                                            Value="{Binding UpdateMaterialCommand}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextAlignment="Center" />
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>



            </Grid>
        </Border>
    </Grid>
</UserControl>
