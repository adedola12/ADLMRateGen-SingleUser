<UserControl x:Class="ADLMRateGen.View.ConcreteWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <!-- ───────── LAYOUT ───────── -->
    <Border BorderBrush="{DynamicResource LightGrayBrush}"
            BorderThickness="2"
            Effect="{StaticResource SoftShadow}"
            CornerRadius="6"
            Padding="20,0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Concreteworks Computation"
                               Style="{StaticResource EstHeader}" />
                    <TextBlock Text="Using Material and Labour Prices from the Library"
                               Style="{StaticResource EstSubheader}" />
                </StackPanel>

                <!-- Add‑custom‑rate button -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonCus}"
                        Command="{Binding AddCustomRateCommand}"
                        Width="276"
                        Margin="24,0,0,0"
                        HorizontalAlignment="Right">

                    <TextBlock Text="Add Custom Rate  ＋"
                               Style="{StaticResource BtnText}" />
                </Button>
            </DockPanel>


            <Border Background="{DynamicResource MainBg}"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource LightGrayBrush}"
                    Padding="24"
                    SnapsToDevicePixels="True"
                    Grid.Row="1"
                    Margin="0,22,0,-22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0"
                          Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="110" />

                        </Grid.ColumnDefinitions>


                        <!-- ────── Overhead ────── -->
                        <Border Background="{DynamicResource DisabledBgBrush}"
                                BorderBrush="{DynamicResource BorderBrushLight}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,0"
                                Height="46">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Overhead -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Text -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- % -->
                                </Grid.ColumnDefinitions>

                                <!-- Overhead -->
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource OOText}"
                                           Text="Overhead" />

                                <!-- Centered Text Displaying the Value (Use a TextBlock Instead of TextBox if Non-editable) -->
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource OPTextBox}"
                                         Text="{Binding OverheadPercent, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="0"
                                         FontWeight="SemiBold"
                                         FontFamily="{DynamicResource Mont}"
                                         Foreground="{DynamicResource Grey700}" />


                                <!-- Percentage sign -->
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource OPText}"
                                           Text="%" />
                            </Grid>
                        </Border>

                        <!-- ────── Profit ────── -->
                        <Border Background="{DynamicResource DisabledBgBrush}"
                                BorderBrush="{DynamicResource BorderBrushLight}"
                                BorderThickness="1"
                                Grid.Column="2"
                                CornerRadius="8"
                                Padding="14,0"
                                Height="46">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Profit -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Text -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- % -->
                                </Grid.ColumnDefinitions>

                                <!-- Profit -->
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource OSPText}"
                                           Text="Profit" />

                                <!-- Centered Text Displaying the Value (Use a TextBlock Instead of TextBox if Non-editable) -->
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource OPTextBox}"
                                         Text="{Binding ProfitPercent, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="0"
                                         FontWeight="SemiBold"
                                         FontFamily="{DynamicResource Mont}"
                                         Foreground="{DynamicResource Grey700}" />


                                <!-- Percentage sign -->
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource OPText}"
                                           Text="%" />
                            </Grid>
                        </Border>

                        <!-- Search -->
                        <Grid Grid.Column="4"
                              Height="46">
                            <TextBox Style="{StaticResource SearchBoxWithIcon}"
                                     Tag="Search description…"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />

                        </Grid>

                        <!-- ────── Buttons ────── -->
                        <Button Grid.Column="6"
                                Content="Filter ⌄"
                                Command="{Binding FilterCommand}"
                                Style="{StaticResource RectButton}" />

                        <Button Grid.Column="8"
                                Content="Sort by ⌄"
                                Style="{StaticResource RectButton}"
                                Command="{Binding SortCommand}" />


                    </Grid>

                    <!-- 3. Rate Data -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ConcreteworkCollectionView}"
                              Style="{StaticResource DataGridStyle}">


                        <DataGrid.Columns>
                            <DataGridTextColumn Header="S/N"
                                                Binding="{Binding ItemNo}"
                                                Width="0.7*"
                                                ElementStyle="{StaticResource CenterCellNr}" />

                            <DataGridTemplateColumn Header="Description"
                                                    Width="4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}"
                                                   ToolTip="{Binding Description}"
                                                   Foreground="{StaticResource Blue900Brush}"
                                                   Style="{StaticResource TableDescriptionText}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ShowDetailsCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Unit"
                                                Binding="{Binding Unit}"
                                                Width="0.9*"
                                                ElementStyle="{StaticResource CenterCellNr}" />
                            <DataGridTextColumn Header="Net Cost"
                                                Binding="{Binding NetCost,  
                                                Converter={StaticResource MoneyConv},   StringFormat=N2}"
                                                Width="1.2*"
                                                ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="Profit"
                                                Binding="{Binding ProfitValue,  Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                Width="1.1*"
                                                ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="Overhead"
                                                Binding="{Binding OverheadValue,  Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                Width="1.1*"
                                                ElementStyle="{StaticResource CenterCellText}" />
                            <DataGridTextColumn Header="Total Cost"
                                                Binding="{Binding TotalCost,   Converter={StaticResource MoneyConv}, StringFormat=N2}"
                                                Width="1.3*"
                                                ElementStyle="{StaticResource CenterCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>



            </Border>

        </Grid>
    </Border>
</UserControl>
