<UserControl x:Class="ADLMRateGen.View.LibraryShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="12 6 12 10">

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <!-- price notice, collapses to nothing when there is none -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--──────── TOP TAB BAR ─────────-->
        <Grid Grid.Row="0"
              Height="60"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!-- Pricing location is set on the ADLM website, on your profile, and
                 arrives here on the next sign-in. The picker used to sit here too,
                 which meant two places could disagree about where you price from.
                 The note stays so the screen still says which zone your prices come
                 from — removing the control should not remove the answer. -->
            <TextBlock Grid.Column="1"
                       Text="{Binding LocationNote}"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Opacity="0.75"
                       ToolTip="Set your pricing location on your ADLM profile on the website. It applies here on your next sign-in."
                       Foreground="{DynamicResource Blue900Brush}" />

            <Border CornerRadius="16"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource MainBg}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>
                    <!-- Material tab -->
                    <RadioButton Grid.Column="0"
                                 IsChecked="{Binding IsMaterialTab, Mode=TwoWay}"
                                 Style="{StaticResource FlatTabButton}">
                        Material
                    </RadioButton>

                    <!-- Labour tab -->
                    <RadioButton Grid.Column="1"
                                 IsChecked="{Binding IsLabourTab, Mode=TwoWay}"
                                 Style="{StaticResource FlatTabButton}">
                        Labour
                    </RadioButton>
                </Grid>
            </Border>



            <!-- The library Undo now lives in the header, as its own icon
                 (ClockRotateLeft), so it is reachable without the toolbar and
                 does not share the Undo arrow with Reset all rate edits.
                 See Controls/Header.xaml. -->

            <!-- Add button -->


            <Button Grid.Column="2"
                    Command="{Binding AddCommand}"
                    Style="{DynamicResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Foreground="{DynamicResource LightGrayBrush}"
                    Margin="0,0,12,0">
                <TextBlock Text="{Binding AddButtonText}"
                           Style="{StaticResource BtnText}" />
            </Button>
        </Grid>

        <!--──────── YOUR PRICES vs NEWLY PUBLISHED ONES ─────────

             Shown only when the two disagree. Nothing has been lost by the time
             this appears: the figures the user typed are already the ones in use,
             and this is an offer to switch, not a warning.

             Per row, because "all or nothing" was the wrong question — someone may
             well want the new cement price and not the new diesel one. -->
        <Border Grid.Row="1"
                Margin="0,18,0,0"
                CornerRadius="12"
                Background="{DynamicResource MainBg}"
                BorderBrush="{DynamicResource BorderBrushLight}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                Visibility="{Binding IsPriceConflictPanelVisible, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── title bar ── -->
                <Grid Grid.Row="0"
                      Margin="16,14,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="10"
                            VerticalAlignment="Top"
                            Background="{DynamicResource LightGrayBrush}">
                        <fa:IconBlock Icon="Tags"
                                      Width="13"
                                      Height="13"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource Blue900Brush}" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding PriceConflictSummary}"
                                   FontFamily="{DynamicResource PoppinsFont}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Blue900Brush}" />
                        <TextBlock Text="{Binding PriceConflictDetail}"
                                   FontFamily="{DynamicResource PoppinsFont}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource CellTextBrush}" />
                    </StackPanel>

                    <!-- Hiding is not deciding: the review comes back from the bell. -->
                    <Button Grid.Column="2"
                            Command="{Binding HidePriceConflictsCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="28"
                            Height="28"
                            Cursor="Hand"
                            VerticalAlignment="Top"
                            ToolTip="Hide this for now. Reopen it from the notifications bell.">
                        <fa:IconBlock Icon="Times"
                                      Width="12"
                                      Height="12"
                                      Foreground="{DynamicResource CellTextBrush}" />
                    </Button>
                </Grid>

                <!-- ── column headings ── -->
                <!-- The scrollbar below steals width from the rows but not from this
                     bar, which left every heading sitting to the right of its own
                     column. Give the padding back only while the bar is actually up. -->
                <Border Grid.Row="1"
                        Background="{DynamicResource LightGrayBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding"
                                    Value="16,7" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=ConflictScroller}"
                                             Value="Visible">
                                    <Setter Property="Padding"
                                            Value="16,7,33,7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsThreeState="True"
                                  IsChecked="{Binding AllConflictsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  ToolTip="Select or clear every row" />

                        <TextBlock Grid.Column="1"
                                   Text="Item"
                                   FontFamily="{DynamicResource PoppinsFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HeaderTextBrush}" />
                        <TextBlock Grid.Column="2"
                                   Text="Unit"
                                   FontFamily="{DynamicResource PoppinsFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HeaderTextBrush}" />
                        <TextBlock Grid.Column="3"
                                   Text="Your price"
                                   FontFamily="{DynamicResource PoppinsFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource HeaderTextBrush}" />
                        <TextBlock Grid.Column="4"
                                   Text="Published"
                                   FontFamily="{DynamicResource PoppinsFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource HeaderTextBrush}" />
                        <TextBlock Grid.Column="5"
                                   Text="Change"
                                   FontFamily="{DynamicResource PoppinsFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource HeaderTextBrush}" />
                    </Grid>
                </Border>

                <!-- ── the rows ── -->
                <ScrollViewer Grid.Row="2"
                              x:Name="ConflictScroller"
                              MaxHeight="196"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PriceConflictRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,8"
                                        BorderBrush="{DynamicResource BorderBrushLight}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{DynamicResource PoppinsFont}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource CellTextBrush}" />
                                            <TextBlock Text="{Binding Kind}"
                                                       FontFamily="{DynamicResource PoppinsFont}"
                                                       FontSize="10"
                                                       Opacity="0.6"
                                                       Foreground="{DynamicResource CellTextBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Unit}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource CellTextBrush}" />

                                        <!-- Yours is in force today, so it reads as the firm value. -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding YourPrice, Converter={StaticResource MoneyConv}, StringFormat=N0}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource CellTextBrush}" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding PublishedPrice, Converter={StaticResource MoneyConv}, StringFormat=N0}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Opacity="0.85"
                                                   Foreground="{DynamicResource CellTextBrush}" />

                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding ChangeText}"
                                                   FontFamily="{DynamicResource PoppinsFont}"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource CellTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIncrease}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource PriceUpBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsIncrease}"
                                                                     Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource PriceDownBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ── actions ── -->
                <Grid Grid.Row="3"
                      Margin="16,12,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectionSummary}"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource PoppinsFont}"
                               FontSize="11.5"
                               Opacity="0.75"
                               Foreground="{DynamicResource CellTextBrush}" />

                    <Button Grid.Column="1"
                            Command="{Binding KeepMyPricesCommand}"
                            IsEnabled="{Binding HasSelectedConflicts}"
                            Style="{DynamicResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Padding="14,6"
                            VerticalAlignment="Center"
                            ToolTip="Keep your own figures on the ticked rows, and stop asking about them.">
                        <TextBlock Text="Keep mine"
                                   Style="{DynamicResource BtnTextSecondary}" />
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding UseServerPricesCommand}"
                            IsEnabled="{Binding HasSelectedConflicts}"
                            Style="{DynamicResource PrimaryButton}"
                            Padding="14,6"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            ToolTip="Take the published price on the ticked rows. Archived first, so it can be undone.">
                        <TextBlock Text="Use published"
                                   Style="{DynamicResource BtnText}" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!--──────── BODY (fills remaining space) ─────────-->
        <ContentControl Grid.Row="2"
                        Content="{Binding CurrentContent}"
                        Margin="0,28,0,0" />

    </Grid>



</UserControl>
