<UserControl x:Class="ADLMRateGen.View.LibraryShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="12 6 12 10">

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <!-- price notice, collapses to nothing when there is none -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--──────── TOP TAB BAR ─────────-->
        <Grid Grid.Row="0"
              Height="60"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!-- Pricing location is set on the ADLM website, on your profile, and
                 arrives here on the next sign-in. The picker used to sit here too,
                 which meant two places could disagree about where you price from.
                 The note stays so the screen still says which zone your prices come
                 from — removing the control should not remove the answer. -->
            <TextBlock Grid.Column="1"
                       Text="{Binding LocationNote}"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Opacity="0.75"
                       ToolTip="Set your pricing location on your ADLM profile on the website. It applies here on your next sign-in."
                       Foreground="{DynamicResource Blue900Brush}" />

            <Border CornerRadius="16"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource MainBg}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>
                    <!-- Material tab -->
                    <RadioButton Grid.Column="0"
                                 IsChecked="{Binding IsMaterialTab, Mode=TwoWay}"
                                 Style="{StaticResource FlatTabButton}">
                        Material
                    </RadioButton>

                    <!-- Labour tab -->
                    <RadioButton Grid.Column="1"
                                 IsChecked="{Binding IsLabourTab, Mode=TwoWay}"
                                 Style="{StaticResource FlatTabButton}">
                        Labour
                    </RadioButton>
                </Grid>
            </Border>



            <!-- The library Undo now lives in the header, as its own icon
                 (ClockRotateLeft), so it is reachable without the toolbar and
                 does not share the Undo arrow with Reset all rate edits.
                 See Controls/Header.xaml. -->

            <!-- Add button -->


            <Button Grid.Column="2"
                    Command="{Binding AddCommand}"
                    Style="{DynamicResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Foreground="{StaticResource LightGrayBrush}"
                    Margin="0,0,12,0">
                <TextBlock Text="{Binding AddButtonText}"
                           Style="{StaticResource BtnText}" />
            </Button>
        </Grid>

        <!--──────── YOUR PRICES vs NEWLY PUBLISHED ONES ─────────

             Shown only when the two disagree. Nothing has been lost by the time
             this appears: the user's own figures are already the ones in use, and
             this is an offer to switch, not a warning. -->
        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Padding="12,8"
                CornerRadius="8"
                Background="{DynamicResource MainBg}"
                BorderBrush="{DynamicResource Blue900Brush}"
                BorderThickness="1"
                Visibility="{Binding HasPriceConflicts, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding PriceConflictSummary}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding PriceConflicts_Rows}"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11"
                                           Opacity="0.8"
                                           TextWrapping="Wrap"
                                           Text="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding KeepMyPricesCommand}"
                        Margin="8,0"
                        Padding="12,4"
                        VerticalAlignment="Center"
                        ToolTip="Keep the prices you entered. Nothing changes.">
                    <TextBlock Text="Keep mine"
                               VerticalAlignment="Center" />
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding UseServerPricesCommand}"
                        Style="{DynamicResource PrimaryButton}"
                        Padding="12,4"
                        VerticalAlignment="Center"
                        ToolTip="Replace your figures with the newly published prices. Archived first, so it can be undone.">
                    <TextBlock Text="Use published"
                               Style="{StaticResource BtnText}" />
                </Button>
            </Grid>
        </Border>

        <!--──────── BODY (fills remaining space) ─────────-->
        <ContentControl Grid.Row="2"
                        Content="{Binding CurrentContent}"
                        Margin="0,28,0,0" />

    </Grid>



</UserControl>
