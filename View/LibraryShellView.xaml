<UserControl x:Class="ADLMRateGen.View.LibraryShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="12 6 12 10">

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <!-- price notice, collapses to nothing when there is none -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--──────── TOP TAB BAR ─────────-->
        <Grid Grid.Row="0"
              Height="60"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!-- Pricing location. Sits beside the tabs because it governs both
                 the material and the labour library, not one of them. -->
            <StackPanel Grid.Column="1"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding States}"
                          SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding IsLocationPickerEnabled}"
                          ToolTip="The state you are pricing in. Prices are graded by geopolitical zone, so states in the same zone read alike until one is priced individually."
                          Height="34"
                          VerticalContentAlignment="Center" />
                <TextBlock Text="{Binding LocationNote}"
                           FontSize="10"
                           Margin="4,2,0,0"
                           Opacity="0.7"
                           Foreground="{DynamicResource Blue900Brush}" />
            </StackPanel>

            <Border CornerRadius="16"
                    SnapsToDevicePixels="True"
                    Background="{DynamicResource MainBg}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>
                    <!-- Material tab -->
                    <RadioButton Grid.Column="0"
                                 IsChecked="{Binding IsMaterialTab, Mode=TwoWay}"
                                 Style="{StaticResource FlatTabButton}">
                        Material
                    </RadioButton>

                    <!-- Labour tab -->
                    <RadioButton Grid.Column="1"
                                 IsChecked="{Binding IsLabourTab, Mode=TwoWay}"
                                 Style="{StaticResource FlatTabButton}">
                        Labour
                    </RadioButton>
                </Grid>
            </Border>



            <!-- Undo. Every sync, state change and price acceptance archives the
                 library first, so this is always able to go back. -->
            <Grid Grid.Column="2"
                  VerticalAlignment="Center">
                <Button Command="{Binding OpenArchiveCommand}"
                        Height="34"
                        Padding="10,0"
                        ToolTip="Go back to an earlier copy of the material and labour libraries">
                    <TextBlock Text="Undo…"
                               VerticalAlignment="Center" />
                </Button>

                <Popup IsOpen="{Binding IsArchiveOpen, Mode=TwoWay}"
                       StaysOpen="False"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource MainBg}"
                            BorderBrush="{DynamicResource Blue900Brush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Width="380">
                        <StackPanel>
                            <TextBlock Text="Restore an earlier library"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Pick a point to go back to. The current library is archived first, so a restore can itself be undone."
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Opacity="0.75"
                                       Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding Archives}"
                                     SelectedItem="{Binding SelectedArchive, Mode=TwoWay}"
                                     DisplayMemberPath="Label"
                                     MaxHeight="220" />
                            <TextBlock Text="No earlier copies yet."
                                       FontSize="11"
                                       Opacity="0.7"
                                       Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Archives.Count}"
                                                         Value="0">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Command="{Binding RestoreCommand}"
                                    Style="{DynamicResource PrimaryButton}"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0"
                                    Padding="14,4">
                                <TextBlock Text="Restore"
                                           Style="{StaticResource BtnText}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Add button -->


            <Button Grid.Column="3"
                    Command="{Binding AddCommand}"
                    Style="{DynamicResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Foreground="{StaticResource LightGrayBrush}"
                    Margin="0,0,12,0">
                <TextBlock Text="{Binding AddButtonText}"
                           Style="{StaticResource BtnText}" />
            </Button>
        </Grid>

        <!--──────── YOUR PRICES vs NEWLY PUBLISHED ONES ─────────

             Shown only when the two disagree. Nothing has been lost by the time
             this appears: the user's own figures are already the ones in use, and
             this is an offer to switch, not a warning. -->
        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Padding="12,8"
                CornerRadius="8"
                Background="{DynamicResource MainBg}"
                BorderBrush="{DynamicResource Blue900Brush}"
                BorderThickness="1"
                Visibility="{Binding HasPriceConflicts, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding PriceConflictSummary}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding PriceConflicts_Rows}"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11"
                                           Opacity="0.8"
                                           TextWrapping="Wrap"
                                           Text="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding KeepMyPricesCommand}"
                        Margin="8,0"
                        Padding="12,4"
                        VerticalAlignment="Center"
                        ToolTip="Keep the prices you entered. Nothing changes.">
                    <TextBlock Text="Keep mine"
                               VerticalAlignment="Center" />
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding UseServerPricesCommand}"
                        Style="{DynamicResource PrimaryButton}"
                        Padding="12,4"
                        VerticalAlignment="Center"
                        ToolTip="Replace your figures with the newly published prices. Archived first, so it can be undone.">
                    <TextBlock Text="Use published"
                               Style="{StaticResource BtnText}" />
                </Button>
            </Grid>
        </Border>

        <!--──────── BODY (fills remaining space) ─────────-->
        <ContentControl Grid.Row="2"
                        Content="{Binding CurrentContent}"
                        Margin="0,28,0,0" />

    </Grid>



</UserControl>
