<UserControl x:Class="ADLMRateGen.View.MaterialLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ADLMRateGen.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Section -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid fills the remaining space -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="All Materials with Prices" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="All necessary information" FontSize="15"/>
        </StackPanel>
        
        <!-- 3. Filter Section -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
               
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"  VerticalAlignment="Center" Margin="5">
                <TextBlock Text="Select Material Category:" FontSize="15" FontWeight="DemiBold" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding MaterialCategory}"
                  SelectedItem="{Binding SelectedMaterialCategory, Mode=TwoWay}"
                   Height="30" Width="150" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Search -->
            <StackPanel Grid.Column="1" Margin="5">
                <TextBlock Text="Search Name" FontSize="15" FontWeight="DemiBold"/>
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
            </StackPanel>

            <Button Grid.Column="2" Content="Update Prices"
                    Command="{Binding UpdatePricesCommand}"
                     Margin="10,10,18,10" Height="40" FontWeight="Bold" FontSize="15"/>


        </Grid>

        <!-- 4. DataGrid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding MaterialCollectionView}" 
           AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,10,0,10" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="S/N" Binding="{Binding SerialNumber}" Width="Auto"/>
                <DataGridTextColumn Header="Material Name" Binding="{Binding MaterialName}" Width="*"/>
                <DataGridTemplateColumn Header="Material Name" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MaterialName}"
         TextWrapping="Wrap"
         Padding="5,2,5,2"
         Foreground="DarkBlue"
         Cursor="Hand" ToolTip="Edit this entry"
         >
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                  Command="{Binding DataContext.EditMaterialCommand, 
                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                  CommandParameter="{Binding}"  />
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Material Unit" Binding="{Binding MaterialUnit}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding MaterialPrice, StringFormat=N2}" Width="Auto"/>
                <DataGridTextColumn Header="Category" Binding="{Binding MaterialCategory}" Width="*"/>

               


            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
