<UserControl x:Class="ADLMRateGen.View.PopupHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid>
        <!-- dim background -->
        <Rectangle Fill="#88000000" />

        <!-- popup card -->
        <Border x:Name="Card"
                Width="600"
                MaxHeight="650"
                Padding="24"
                Background="White"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <!-- close button -->
                <Button Content="✕"
                        Width="30"
                        Height="30"
                        FontSize="16"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Cursor="Hand"
                        Click="OnClose" />
                <!-- here we inject the view -->
                <ContentPresenter Margin="0,40,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
