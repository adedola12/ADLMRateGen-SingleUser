<Window x:Class="ADLMRateGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ADLMRateGen.ViewModel"
        xmlns:controls="clr-namespace:ADLMCivilPlugin.Controls"
        xmlns:view="clr-namespace:ADLMRateGen.View"
        xmlns:ground="clr-namespace:ADLMRateGen.ViewModel.Groundwork"
        xmlns:concrete="clr-namespace:ADLMRateGen.ViewModel.ConcreteWork"
        xmlns:blockwork="clr-namespace:ADLMRateGen.ViewModel.BlockWork"
        xmlns:finishes="clr-namespace:ADLMRateGen.ViewModel.Finishes"
        xmlns:roof="clr-namespace:ADLMRateGen.ViewModel.RoofWork"
        xmlns:windowAndDoor="clr-namespace:ADLMRateGen.ViewModel.WindowAndDoor"
        xmlns:paint="clr-namespace:ADLMRateGen.ViewModel.Painting"
        xmlns:steel="clr-namespace:ADLMRateGen.ViewModel.SteelWork"
        xmlns:customInput="clr-namespace:ADLMRateGen.ViewModel.CustomRate"
        xmlns:helpers="clr-namespace:ADLMRateGen.Helpers"
        mc:Ignorable="d"
        Title="" 
        WindowStyle="SingleBorderWindow"
        Height="750" Width="1080">

    <Window.Resources>
        <!-- 
          DataTemplates: Tells WPF which UserControl to display for each ViewModel type.
          The most important one is for SignInViewModel => SignInUserControl
        -->
        <DataTemplate DataType="{x:Type vm:SignInViewModel}">
            <view:SignInUserControl/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaterialLibraryViewModel}">
            <view:MaterialLibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaterialPriceViewModel}">
            <view:MaterialPriceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LabourLibraryViewModel}">
            <view:LabourLibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LabourPriceViewModel}">
            <view:LabourPriceView/>
        </DataTemplate>

        <!-- Additional data templates for other sub-ViewModels: -->
        <DataTemplate DataType="{x:Type ground:GroundWorkViewModel}">
            <view:GroundWorkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type concrete:ConcreteViewModel}">
            <view:ConcreteWorkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type blockwork:BlockworkViewModel}">
            <view:BlockworkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type finishes:FinishesViewModel}">
            <view:FinishesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type customInput:CustomRateEntryViewModel}">
            <view:CustomRateEntryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type customInput:CustomRateListViewModel}">
            <view:CustomRateListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type roof:RoofWorkViewModel}">
            <view:RoofworkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type windowAndDoor:WindowAndDoorViewModel}">
            <view:WindowAndDoorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type paint:PaintWorkViewModel}">
            <view:PaintworkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type steel:SteelWorkViewModel}">
            <view:SteelworkView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#cdd6db">
        <!-- Overall layout: 
             Row 0: Header
             Row 1: (Auto) might be for something else if needed
             Row 2: main area => left side is sidebar, right side is content
             Row 3: footer
        -->

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <controls:Header Grid.Row="0" Grid.ColumnSpan="2"/>

        <!-- Sidebar: disabled if not logged in. -->
        <StackPanel Grid.Row="2" Grid.Column="0" Background="LightGray"
                    IsEnabled="{Binding IsLoggedIn}">
            <TextBlock Text="Side Bar" FontSize="18" FontWeight="Bold" Margin="10"/>

            <Button Style="{StaticResource SideBarButtonStyle}"
                    Content="Input Material Price"
                    Command="{Binding SelectedMaterialInputViewCommand}"
                    Margin="10" Padding="5"
                    helpers:ButtonHelper.IsActive="{Binding IsMaterialInputActive}"/>
            <Button Style="{StaticResource SideBarButtonStyle}"
                    Content="Material Price Library"
                    Command="{Binding SelectedMaterialLibraryViewCommand}"
                    Margin="10" Padding="5"
                    helpers:ButtonHelper.IsActive="{Binding IsMaterialLibraryActive}"/>
            <Button Style="{StaticResource SideBarButtonStyle}"
                    Content="Input Labour Rate"
                    Command="{Binding SelectedLabourInputViewCommand}"
                    Margin="10" Padding="5"
                    helpers:ButtonHelper.IsActive="{Binding IsLabourInputActive}"/>
            <Button Style="{StaticResource SideBarButtonStyle}"
                    Content="Labour Rate Library"
                    Command="{Binding SelectedLabourLibraryViewCommand}"
                    Margin="10" Padding="5"
                    helpers:ButtonHelper.IsActive="{Binding IsLabourLibraryActive}"/>
            <Button Style="{StaticResource SideBarButtonStyle}"
                    Content="Build Custom Rate"
                    Command="{Binding SelectedCustomRateViewCommand}"
                    Margin="10" Padding="5"
                    helpers:ButtonHelper.IsActive="{Binding IsCustomRateInputActive}"/>
        </StackPanel>

        <!-- Main Section (right side): also disabled if not logged in. -->
        <Grid Grid.Row="2" Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Sub‐section Buttons row -->
            <!-- Sub‐section Buttons row -->
            <StackPanel Grid.Row="0" Background="LightGray" Orientation="Horizontal" IsEnabled="{Binding IsLoggedIn}">
                <Button Style="{StaticResource TopNavButtonStyle}"
            Content="Ground"
            Command="{Binding SelectedGroundworkViewCommand}"
            helpers:ButtonHelper.IsActive="{Binding IsGroundworkActive}"/>
                <Button Style="{StaticResource TopNavButtonStyle}"
            Content="Concrete"
            Command="{Binding SelectedConcreteWorkViewCommand}"
            helpers:ButtonHelper.IsActive="{Binding IsConcreteViewActive}"/>
                <Button Style="{StaticResource TopNavButtonStyle}"
            Content="BlockWorks"
            Command="{Binding SelectedBlockworkViewCommand}"
            helpers:ButtonHelper.IsActive="{Binding IsBlockworkActive}"/>
                <Button Style="{StaticResource TopNavButtonStyle}"
            Content="Finishes"
            Command="{Binding SelectedFinishesViewCommand}"
            helpers:ButtonHelper.IsActive="{Binding IsFinishesActive}"/>
                <Button Style="{StaticResource TopNavButtonStyle}"
            Content="Roof"
            Command="{Binding SelectedRoofworkViewCommand}"
            helpers:ButtonHelper.IsActive="{Binding IsRoofworkActive}"/>
                <Button Style="{StaticResource TopNavButtonStyle}"
            Content="Windows Doors"
            Command="{Binding SelectedWindowAndDoorViewCommand}"
            helpers:ButtonHelper.IsActive="{Binding IsWindowAndDoorActive}"/>
                <Button Style="{StaticResource TopNavButtonStyle}"
            Content="Painting"
            Command="{Binding SelectedPaintworkViewCommand}"
            helpers:ButtonHelper.IsActive="{Binding IsPaintingActive}"/>
                <Button Style="{StaticResource TopNavButtonStyle}"
            Content="Steel"
            Command="{Binding SelectedSteelworkViewCommand}"
            helpers:ButtonHelper.IsActive="{Binding IsSteelworkActive}"/>
                <Button Style="{StaticResource TopNavButtonStyle}"
            Content="Custom Rate"
            Command="{Binding SelectedCustomRateInputViewCommand}"
            helpers:ButtonHelper.IsActive="{Binding IsCustomRateInputActive}"/>
            </StackPanel>

            <!-- Content area: 
                 This will display either SignInViewModel (if not logged in)
                 or something else (MaterialLibraryViewModel, etc.) if logged in.
            -->
            <ContentControl Grid.Row="1" Content="{Binding SelectedViewModel}"/>
        </Grid>

        <!-- Footer -->
        <controls:Footer Grid.Row="3" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
