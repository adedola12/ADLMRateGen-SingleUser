                        <!-- centred horizontal layout -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- ①  icon – replace Source with whatever you put in /Resources -->
                            <TextBlock Text=""
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="White"
                                       Margin="0,0,10,0"
                                       FontSize="18" />


                            <!-- ②  label -->
                            <TextBlock Text="Library"
                                       Foreground="White"
                                       FontFamily="Poppins"
                                       FontWeight="Bold"
                                       FontSize="16" />
                        </StackPanel>
                    </Button>


                    <!-- section label -->
                    <TextBlock Text="Item of works"
                               FontFamily="Poppins"
                               Margin="0,24,0,12"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#091E39" />

