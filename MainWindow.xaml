<Window x:Class="ADLMRateGen.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ADLMRateGen.ViewModel"
        xmlns:view="clr-namespace:ADLMRateGen.View"
        xmlns:controls="clr-namespace:ADLMCivilPlugin.Controls"
        xmlns:ground="clr-namespace:ADLMRateGen.ViewModel.Groundwork"
        xmlns:concrete="clr-namespace:ADLMRateGen.ViewModel.ConcreteWork"
        xmlns:blockwork="clr-namespace:ADLMRateGen.ViewModel.BlockWork"
        xmlns:finishes="clr-namespace:ADLMRateGen.ViewModel.Finishes"
        xmlns:roof="clr-namespace:ADLMRateGen.ViewModel.RoofWork"
        xmlns:windowAndDoor="clr-namespace:ADLMRateGen.ViewModel.WindowAndDoor"
        xmlns:paint="clr-namespace:ADLMRateGen.ViewModel.Painting"
        xmlns:carbon="clr-namespace:ADLMRateGen.ViewModel.CarbonOthers"
        xmlns:steel="clr-namespace:ADLMRateGen.ViewModel.SteelWork"
        xmlns:customInput="clr-namespace:ADLMRateGen.ViewModel.CustomRate"
        xmlns:helpers="clr-namespace:ADLMRateGen.Helpers"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:ADLMRateGen.Converters"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="ADLM Rate Gen"
        WindowStyle="SingleBorderWindow"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MainBg}">
    <!-- ───────── RESOURCES ───────── -->
    <Window.Resources>
        <ResourceDictionary>
            <conv:FirstNameConverter x:Key="FirstNameConv" />
            <!-- ── VIEW  DATA-TEMPLATES  (unchanged) ── -->
            <DataTemplate DataType="{x:Type vm:SignInViewModel}">
                <view:SignInUserControl />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialLibraryViewModel}">
                <view:MaterialLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialPriceViewModel}">
                <view:MaterialPriceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabourLibraryViewModel}">
                <view:LabourLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabourPriceViewModel}">
                <view:LabourPriceView />
            </DataTemplate>
            <!-- discipline templates -->
            <DataTemplate DataType="{x:Type ground:GroundWorkViewModel}">
                <view:GroundWorkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type concrete:ConcreteViewModel}">
                <view:ConcreteWorkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type blockwork:BlockworkViewModel}">
                <view:BlockworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type finishes:FinishesViewModel}">
                <view:FinishesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type roof:RoofWorkViewModel}">
                <view:RoofworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type windowAndDoor:WindowAndDoorViewModel}">
                <view:WindowAndDoorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type paint:PaintWorkViewModel}">
                <view:PaintworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type steel:SteelWorkViewModel}">
                <view:SteelworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type carbon:CarbonOthersViewModel}">
                <view:CarbonOthersView />
            </DataTemplate>
            <!-- custom-rate -->
            <DataTemplate DataType="{x:Type customInput:CustomRateEntryViewModel}">
                <view:CustomRateEntryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type customInput:CustomRateListViewModel}">
                <view:CustomRateListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LibraryShellViewModel}">
                <view:LibraryShellView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <!-- ───────── MAIN LAYOUT ───────── -->
    <Grid UseLayoutRounding="True"
          SnapsToDevicePixels="True">
            <!-- Sign-in overlay -->
            <ContentControl Content="{Binding SignInViewModel}"
                            Visibility="{Binding DataContext.IsLoggedIn,
                                                 ElementName=Root,
                                                 Converter={StaticResource InvBoolVis}}" />
            <!-- Logged-in shell -->
            <Grid x:Name="MainLayout"
                  Visibility="{Binding DataContext.IsLoggedIn,
                                       ElementName=Root,
                                       Converter={StaticResource BoolVis}}">
                <!-- ROWS  0-Header | 1-Body -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <!-- COLUMNS  0-Sidebar | 1-Main -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--────────  SIDEBAR – spans ALL rows  ────────-->
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Grid.RowSpan="2"
                        Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="0,0,16,0"
                        Effect="{DynamicResource SoftShadow}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,28,24,24">
                        <Image Source="/Resources/adlm_rate_generator_logo_small.png"
                               Width="90"
                               Margin="0,0,0,28"
                               HorizontalAlignment="Center" />
                        <Button Style="{DynamicResource NavPrimaryButton}"
                                Command="{Binding SelectedMaterialLibraryViewCommand}"
                                helpers:ButtonHelper.IsActive="{Binding IsMaterialLibraryActive}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fa:IconBlock Icon="ThLarge"
                                              Width="24"
                                              Height="20"
                                              Margin="0,0,8,0"
                                              Foreground="{DynamicResource BackgroundBrush}" />
                                <TextBlock Text="Library"
                                           Grid.Column="1"
                                           Foreground="{DynamicResource BackgroundBrush}"
                                           FontFamily="Poppins"
                                           FontWeight="Bold"
                                           FontSize="20" />
                            </Grid>
                        </Button>
                        <!--<Button Content="Run Sanity Check"
                                Command="{Binding RunSanityCheckCommand}" />-->
                        <Button Command="{Binding RefreshCloudDataCommand}"
                                ToolTip="Sync from Cloud"
                                Width="38"
                                Height="32"
                                Margin="6,0"
                                Style="{StaticResource SidebarSubButton}">
                            <fa:IconImage Icon="SyncAlt"
                                          Width="16"
                                          Height="16" />
                        </Button>
                        <TextBlock Text="{Binding CloudSyncStatus}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Opacity="0.8" />
                        <TextBlock Text="Item of works"
                                   FontFamily="Poppins"
                                   Margin="0,24,0,12"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Blue900Brush}" />
                        <Rectangle Height="1"
                                   Margin="0,20,0,0"
                                   Fill="{DynamicResource divBrush}" />
                        <!-- work-item buttons -->
                        <StackPanel>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedGroundworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsGroundworkActive}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Truck"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Ground"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedConcreteWorkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsConcreteViewActive}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Mixer"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Concrete"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedBlockworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsBlockworkActive}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="TrowelBricks"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Block Works"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedFinishesViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsFinishesActive}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="SheetPlastic"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Finishes"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedRoofworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsRoofworkActive}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="PeopleRoof"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Roofs"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedPaintworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsPaintingActive}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="PaintRoller"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Painting"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedSteelworkViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsSteelworkActive}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="DrumSteelpan"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Steel"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedWindowAndDoorViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsWindowAndDoorActive}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="DoorOpen"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Window and Door"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedCustomRateInputViewCommand}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Save"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Saved Rates"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding SelectedCarbonOthersViewCommand}"
                                    helpers:ButtonHelper.IsActive="{Binding IsCarbonOthersActive}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="Leaf"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Carbon &amp; Others"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Rectangle Height="1"
                                   Margin="0,20,0,0"
                                   Fill="{DynamicResource divBrush}" />
                        <StackPanel Margin="0,40">
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Margin="0,4"
                                    Click="ToCmApp_Click">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="FileCsv"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="To CM App"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding ExportAllRatesCommand}"
                                    Margin="0,4"
                                    Visibility="{Binding IsExportVisible, Converter={StaticResource BoolVis}, FallbackValue=Visible}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="FileExcel"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Export"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding HelpCommand}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="HandsHelping"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Help"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource SidebarSubButton}"
                                    Command="{Binding LogoutCommand}"
                                    Margin="0,4">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <fa:IconBlock Icon="RightFromBracket"
                                                  Width="24"
                                                  Height="24"
                                                  Foreground="{DynamicResource Blue900Brush}" />
                                    <Rectangle Width="14"
                                               Fill="Transparent" />
                                    <TextBlock Text="Log out"
                                               Style="{DynamicResource BtnSidebarText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <!--────────  HEADER  ─────────-->
                <controls:Header Grid.Row="0"
                                 Grid.Column="1" />
                <!--────────  BODY  ─────────-->
                <Grid Grid.Row="1"
                      Grid.Column="1"
                      Margin="24,0,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Margin="12 0 12 10"
                            Height="250"
                            CornerRadius="18"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/Backdrop.png"
                                        Stretch="Fill" />
                        </Border.Background>
                        <Grid>
                            <Image Source="/Resources/hex_big.png"
                                   Width="220"
                                   HorizontalAlignment="Right"
                                   Margin="0 -100 5 0" />
                            <Image Source="/Resources/hex_big.png"
                                   Width="100"
                                   HorizontalAlignment="Right"
                                   Margin="0,125,250,0"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="-8" />
                                </Image.RenderTransform>
                            </Image>
                            <Grid Margin="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/adlm_badge.png"
                                       Width="52"
                                       Margin="0 90 28 0"
                                       VerticalAlignment="Top" />
                                <Grid Grid.Column="2"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               FontFamily="Poppins"
                                               FontSize="11"
                                               Foreground="#C6D1E7"
                                               Text="{Binding Source={x:Static sys:DateTime.Now},
                                                              StringFormat='{}{0:dddd, d MMMM yyyy | h:mm tt}'}" />
                                    <TextBlock Grid.Row="1"
                                               FontFamily="Poppins"
                                               FontSize="28"
                                               Foreground="White"
                                               FontWeight="SemiBold">
                                        <Run Text="Welcome Back, " />
                                        <Run Text="{Binding CurrentUser.DisplayName, Converter={StaticResource FirstNameConv}, Mode=OneWay}"
                                             FontWeight="Bold" />
                                        <Run Text="!" /></TextBlock>
                                    <StackPanel Grid.Row="2"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Left">
                                        <TextBlock Text="Extracting your quantities just got a lot easier. Try out our Revit and Planswift plugins today!"
                                                   MaxWidth="380"
                                                   FontFamily="Poppins"
                                                   FontSize="12"
                                                   Margin="0,10,0,0"
                                                   Foreground="#D8E0F4"
                                                   TextWrapping="Wrap" />
                                        <Button Style="{StaticResource invBtn}"
                                                Content="Try now  ➜"
                                                Command="{Binding OpenYoutubeCommand}"
                                                Margin="0,24,150,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,0,0,12"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <ContentControl Content="{Binding SelectedViewModel}"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                    </ScrollViewer>
                </Grid>
            </Grid>
            <!-- ✅ Global loader overlay (ONLY ONE PopupHost in this window) -->
            <Grid Panel.ZIndex="150"
                  Background="#80000000"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <Border Width="420"
                        Padding="26"
                        CornerRadius="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource MainBg}"
                        Effect="{DynamicResource SoftShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyMessage}"
                                   FontFamily="Poppins"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Blue900Brush}"
                                   TextAlignment="Center"
                                   Margin="0,0,0,14" />
                        <ProgressBar Height="10"
                                     IsIndeterminate="True" />
                        <TextBlock Text="Please wait…"
                                   FontFamily="Poppins"
                                   FontSize="12"
                                   Opacity="0.8"
                                   Foreground="{DynamicResource Blue900Brush}"
                                   TextAlignment="Center"
                                   Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- ✅ Keep ONLY ONE PopupHost with this name -->
            <view:PopupHost x:Name="PopupHost"
                            Visibility="Collapsed"
                            Panel.ZIndex="99" />
    </Grid>
</Window>
