<Window x:Class="ADLMRateGen.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ADLMRateGen.ViewModel"
        xmlns:view="clr-namespace:ADLMRateGen.View"
        xmlns:controls="clr-namespace:ADLMCivilPlugin.Controls"
        xmlns:ground="clr-namespace:ADLMRateGen.ViewModel.Groundwork"
        xmlns:concrete="clr-namespace:ADLMRateGen.ViewModel.ConcreteWork"
        xmlns:blockwork="clr-namespace:ADLMRateGen.ViewModel.BlockWork"
        xmlns:finishes="clr-namespace:ADLMRateGen.ViewModel.Finishes"
        xmlns:roof="clr-namespace:ADLMRateGen.ViewModel.RoofWork"
        xmlns:windowAndDoor="clr-namespace:ADLMRateGen.ViewModel.WindowAndDoor"
        xmlns:paint="clr-namespace:ADLMRateGen.ViewModel.Painting"
        xmlns:steel="clr-namespace:ADLMRateGen.ViewModel.SteelWork"
        xmlns:customInput="clr-namespace:ADLMRateGen.ViewModel.CustomRate"
        xmlns:helpers="clr-namespace:ADLMRateGen.Helpers"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:ADLMRateGen.Converters"
        mc:Ignorable="d"
        Title="ADLM Rate Gen"
        Height="1020"
        Width="1180"
        WindowStyle="SingleBorderWindow"
        Background="#cdd6db">

    <!-- ───────── RESOURCES ───────── -->
    <Window.Resources>
        <ResourceDictionary>

            <!-- ── SIMPLE STYLES & EFFECTS ── -->
            <DropShadowEffect x:Key="SoftShadow"
                              Color="#000000"
                              BlurRadius="10"
                              ShadowDepth="0"
                              Opacity="0.12" />

            <!-- Primary (navy) button used for “Library” -->
            <Style x:Key="NavPrimaryButton"
                   TargetType="Button">
                <Setter Property="Foreground"
                        Value="White" />
                <Setter Property="Background"
                        Value="#001E44" />
                <Setter Property="FontSize"
                        Value="14" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="14,8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat nav button (left column) -->
            <Style x:Key="NavFlatButton"
                   TargetType="Button">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="Foreground"
                        Value="#374151" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="FontSize"
                        Value="14" />
                <Setter Property="Padding"
                        Value="12,6" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Left" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="root"
                                            Property="Background"
                                            Value="#F3F4F6" />
                                </Trigger>
                                <Trigger Property="helpers:ButtonHelper.IsActive"
                                         Value="True">
                                    <Setter TargetName="root"
                                            Property="Background"
                                            Value="#E8F0FF" />
                                    <Setter Property="Foreground"
                                            Value="#003087" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Simple top-navigation style (blue outline) -->
            <Style x:Key="TopNavButtonStyle"
                   TargetType="Button">
                <Setter Property="Margin"
                        Value="4" />
                <Setter Property="Padding"
                        Value="10,6" />
                <Setter Property="FontSize"
                        Value="13" />
                <Setter Property="BorderBrush"
                        Value="#0078D4" />
                <Setter Property="BorderThickness"
                        Value="1.2" />
                <Setter Property="Background"
                        Value="White" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <conv:FirstNameConverter x:Key="FirstNameConv" />

            <!-- ── VIEW  DATA-TEMPLATES  (unchanged) ── -->
            <DataTemplate DataType="{x:Type vm:SignInViewModel}">
                <view:SignInUserControl />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MaterialLibraryViewModel}">
                <view:MaterialLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialPriceViewModel}">
                <view:MaterialPriceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabourLibraryViewModel}">
                <view:LabourLibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabourPriceViewModel}">
                <view:LabourPriceView />
            </DataTemplate>

            <!-- discipline templates -->
            <DataTemplate DataType="{x:Type ground:GroundWorkViewModel}">
                <view:GroundWorkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type concrete:ConcreteViewModel}">
                <view:ConcreteWorkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type blockwork:BlockworkViewModel}">
                <view:BlockworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type finishes:FinishesViewModel}">
                <view:FinishesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type roof:RoofWorkViewModel}">
                <view:RoofworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type windowAndDoor:WindowAndDoorViewModel}">
                <view:WindowAndDoorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type paint:PaintWorkViewModel}">
                <view:PaintworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type steel:SteelWorkViewModel}">
                <view:SteelworkView />
            </DataTemplate>

            <!-- custom-rate -->
            <DataTemplate DataType="{x:Type customInput:CustomRateEntryViewModel}">
                <view:CustomRateEntryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type customInput:CustomRateListViewModel}">
                <view:CustomRateListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LibraryShellViewModel}">
                <view:LibraryShellView />
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <!-- ───────── MAIN LAYOUT ───────── -->
    <Grid>

        <!-- Sign-in overlay -->
        <ContentControl Content="{Binding SignInViewModel}"
                        Visibility="{Binding DataContext.IsLoggedIn,
                                             ElementName=Root,
                                             Converter={StaticResource InvBoolVis}}" />

        <!-- Logged-in shell -->
        <Grid x:Name="MainLayout"
              Visibility="{Binding DataContext.IsLoggedIn,
                                   ElementName=Root,
                                   Converter={StaticResource BoolVis}}">

