            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition />

            </Grid.RowDefinitions>

            <!-- COLUMNS  0-Sidebar | 1-Main -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--────────  SIDEBAR – spans ALL rows  ────────-->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Grid.RowSpan="3"
                    Background="White"
                    CornerRadius="0,0,16,0"
                    Effect="{StaticResource SoftShadow}">

                <!-- inner content with generous margin -->
                <StackPanel Margin="24,32,24,24"
                            VerticalAlignment="Stretch">

                    <!-- ───── logo ───── -->
                    <Image Source="/Resources/adlm_rate_generator_logo_small.png"
                           Width="120"
                           Margin="0,0,0,32"
                           HorizontalAlignment="Center" />

                    <!-- ───── Library (primary) ───── -->
                    <!-- ───── Library  (icon + white bold Poppins text) ───── -->
