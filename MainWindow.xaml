<Window x:Class="ADLMRateGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ADLMRateGen.ViewModel"
        xmlns:controls="clr-namespace:ADLMCivilPlugin.Controls"
        xmlns:view="clr-namespace:ADLMRateGen.View"
        xmlns:ground="clr-namespace:ADLMRateGen.ViewModel.Groundwork"
        xmlns:concrete="clr-namespace:ADLMRateGen.ViewModel.ConcreteWork"
        xmlns:blockwork="clr-namespace:ADLMRateGen.ViewModel.BlockWork"
        xmlns:finishes="clr-namespace:ADLMRateGen.ViewModel.Finishes"
        xmlns:roof="clr-namespace:ADLMRateGen.ViewModel.RoofWork"
        xmlns:windowAndDoor="clr-namespace:ADLMRateGen.ViewModel.WindowAndDoor"
        xmlns:paint="clr-namespace:ADLMRateGen.ViewModel.Painting"
        xmlns:steel="clr-namespace:ADLMRateGen.ViewModel.SteelWork"
        xmlns:customInput="clr-namespace:ADLMRateGen.ViewModel.CustomRate"
        xmlns:helpers="clr-namespace:ADLMRateGen.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1080">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />


        <DataTemplate DataType="{x:Type vm:MaterialPriceViewModel}">
            <view:MaterialPriceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaterialLibraryViewModel}">
            <view:MaterialLibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LabourPriceViewModel}">
            <view:LabourPriceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LabourLibraryViewModel}">
            <view:LabourLibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ground:GroundWorkViewModel}">
            <view:GroundWorkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type concrete:ConcreteViewModel}">
            <view:ConcreteWorkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type blockwork:BlockworkViewModel}">
            <view:BlockworkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type finishes:FinishesViewModel}">
            <view:FinishesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type customInput:CustomRateEntryViewModel}">
            <view:CustomRateEntryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type customInput:CustomRateListViewModel}">
            <view:CustomRateListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type roof:RoofWorkViewModel}">
            <view:RoofworkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type windowAndDoor:WindowAndDoorViewModel}">
            <view:WindowAndDoorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type paint:PaintWorkViewModel}">
            <view:PaintworkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type steel:SteelWorkViewModel}">
            <view:SteelworkView/>
        </DataTemplate>
    </Window.Resources>


    <Grid>
        <!-- Main Content Grid is only visible if IsLoggedIn == true -->
        <Grid x:Name="MainContentGrid"
              Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <controls:Header Grid.Row="0" Grid.ColumnSpan="2"/>

            <!-- Sidebar -->
            <StackPanel Grid.Row="2" Grid.Column="0" Background="LightGray">
                <TextBlock Text="Side Bar" FontSize="18" FontWeight="Bold" Margin="10"/>
                <Button Content="Input Material Price"
                        Command="{Binding SelectedMaterialInputViewCommand}"
                        Margin="10" Padding="5"/>
                <Button Content="Material Price Library"
                        Command="{Binding SelectedMaterialLibraryViewCommand}"
                        Margin="10" Padding="5"/>
                <Button Content="Input Labour Rate"
                        Command="{Binding SelectedLabourInputViewCommand}"
                        Margin="10" Padding="5"/>
                <Button Content="Labour Rate Library"
                        Command="{Binding SelectedLabourLibraryViewCommand}"
                        Margin="10" Padding="5"/>
                <Button Content="Build Custom Rate"
                        Command="{Binding SelectedCustomRateViewCommand}"
                        Margin="10" Padding="5"/>
            </StackPanel>

            <!-- Main Section -->
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Sub‐section Buttons -->
                <StackPanel Grid.Row="0" Background="LightGray" Orientation="Horizontal">
                    <Button Content="Ground" Command="{Binding SelectedGroundworkViewCommand}" Margin="5" Padding="2" Width="80"/>
                    <Button Content="Concrete" Command="{Binding SelectedConcreteWorkViewCommand}" Margin="5" Padding="2" Width="80"/>
                    <Button Content="BlockWorks" Command="{Binding SelectedBlockworkViewCommand}" Margin="5" Padding="2" Width="80"/>
                    <Button Content="Finishes" Command="{Binding SelectedFinishesViewCommand}" Margin="5" Padding="2" Width="80"/>
                    <Button Content="Roof" Command="{Binding SelectedRoofworkViewCommand}" Margin="5" Padding="2" Width="80"/>
                    <Button Content="Windows Doors" Command="{Binding SelectedWindowAndDoorViewCommand}" Margin="5" Padding="2" Width="100"/>
                    <Button Content="Painting" Command="{Binding SelectedPaintworkViewCommand}" Margin="5" Padding="2" Width="80"/>
                    <Button Content="Steel" Command="{Binding SelectedSteelworkViewCommand}" Margin="5" Padding="2" Width="80"/>
                    <Button Content="Custom Rate" Command="{Binding SelectedCustomRateInputViewCommand}" Margin="5" Padding="2" Width="80"/>
                </StackPanel>

                <!-- Main content area -->
                <ContentControl Grid.Row="1" Content="{Binding SelectedViewModel}"/>
            </Grid>

            <!-- Footer -->
            <controls:Footer Grid.Row="3" Grid.ColumnSpan="2"/>
        </Grid>

        <!-- SignInUserControl is only visible if IsLoggedIn == false -->
        <view:SignInUserControl x:Name="SignInControl"
            Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisConverter}}"
            HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
