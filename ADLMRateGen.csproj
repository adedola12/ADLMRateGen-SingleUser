<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\ADLM Rate Generator Plugin.ico</ApplicationIcon>
    <!-- v2.6.1: AI-built rates kept their prices. A library reload — which every
         save triggers — was zeroing every AI line just before it was written to
         disk. Patch: fixes and UI feedback, no new behaviour. -->
    <Version>2.6.1</Version>
    <AssemblyVersion>2.6.1.0</AssemblyVersion>
    <FileVersion>2.6.1.0</FileVersion>
  </PropertyGroup>

  <!-- The test project lives under this project's directory, so the SDK's
       default **/*.cs glob would otherwise pull its files into the app build
       (and fail on the missing xunit reference). -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <Resource Remove="Tests\**" />
    <Content Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Data\defaultLabours.json" />
    <None Remove="Data\defaultMaterials.json" />
    <None Remove="Images\logoBlack.png" />
    <None Remove="Images\logoBlue.png" />
    <None Remove="Images\logoWhite.png" />
    <None Remove="Resources\adlm_badge.png" />
    <None Remove="Resources\adlm_rate_generator_logo.png" />
    <None Remove="Resources\adlm_rate_generator_logo_small.png" />
    <None Remove="Resources\adlm_studio_logo_small.png" />
    <None Remove="Resources\Backdrop.png" />
    <None Remove="Resources\bg_frame.png" />
    <None Remove="Resources\EUR.png" />
    <None Remove="Resources\GHS.png" />
    <None Remove="Resources\hex_big.png" />
    <None Remove="Resources\NGN.png" />
    <None Remove="Resources\panel_blueprint.png" />
    <None Remove="Resources\QAR.png" />
    <None Remove="Resources\user_avatar.jpg" />
    <None Remove="Resources\ZAR.png" />
    <None Remove="Resources\adlmlogosml.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\defaultLabours.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
