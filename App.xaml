<Application x:Class="ADLMRateGen.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:conv="clr-namespace:ADLMRateGen.Converters"
             ShutdownMode="OnMainWindowClose"
             >


    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>



                <ResourceDictionary Source="/Resources/ADLMStylesTheme.xaml" />
                <!--<ResourceDictionary Source="/Resources/ADLMStylesDarkTheme.xaml" />-->

            </ResourceDictionary.MergedDictionaries>


            <conv:BoolToVis        x:Key="BoolVis" />
            <conv:InverseBoolToVis x:Key="InvBoolVis" />
            <conv:CurrencyDisplayConverter x:Key="CurrencyFmt" />
            <conv:CurrencyDisplayConverter x:Key="MoneyConv" />
            <conv:CurrencyToFlagConverter x:Key="CurrencyToFlagConverter" />


        </ResourceDictionary>
    </Application.Resources>
</Application>
